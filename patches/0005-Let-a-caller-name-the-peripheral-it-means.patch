+/* Slot 0 holds several peripherals and their command ids overlap, so a
+ * broadcast is only safe while the payload sizes happen to differ. These name
+ * the peripheral instead - by its id ("linapple.keyboard") or its name - and
+ * are the way to reach an id that another peripheral in the slot also uses. */
+PeripheralStatus_t peripheral_command_to(int slot, const char* who,
+                                         uint32_t cmd_id, const void* data,
+                                         size_t size);
+PeripheralStatus_t peripheral_query_to(int slot, const char* who,
+                                       uint32_t cmd_id, void* out,
+                                       size_t* out_size);
 void peripheral_save_state(int slot, void* buffer, size_t* size);
