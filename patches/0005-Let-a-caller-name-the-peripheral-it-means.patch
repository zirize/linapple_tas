 }
 
+// Matches on either the namespaced id or the human name, the way the plugin
+// lookup does, so a caller can use whichever it has to hand.
+static auto peripheral_named(int slot, const char* who) -> ActivePeripheral_t* {
+  if (slot < 0 || slot >= static_cast<int>(NUM_SLOTS) || who == nullptr) {
+    return nullptr;
+  }
+  for (auto& ap : g_active_peripherals.at(static_cast<size_t>(slot))) {
+    if (ap.api == nullptr) {
+      continue;
+    }
+    if ((ap.api->id != nullptr && strcmp(ap.api->id, who) == 0) ||
+        (ap.api->name != nullptr && strcmp(ap.api->name, who) == 0)) {
+      return &ap;
+    }
+  }
+  return nullptr;
+}
+
+auto peripheral_command_to(int slot, const char* who, uint32_t cmd_id,
+                           const void* data, size_t size)
+    -> PeripheralStatus_t {
+  if (size > PERIPHERAL_CMD_MAX_DATA) {
+    return peripheral_error;
+  }
+  ActivePeripheral_t* ap = peripheral_named(slot, who);
+  if (ap == nullptr || ap->api->command == nullptr) {
+    return peripheral_error;
+  }
+  // Straight through rather than onto the queue: the queue exists so that a
+  // command sent from another thread lands on an emulation boundary, and it
+  // carries no room for a name. Callers that need that ordering keep using
+  // peripheral_command.
+  return ap->api->command(ap->instance, cmd_id, data, size);
+}
+
+auto peripheral_query_to(int slot, const char* who, uint32_t cmd_id, void* out,
+                         size_t* out_size) -> PeripheralStatus_t {
+  if (out_size == nullptr) {
+    return peripheral_error;
+  }
+  ActivePeripheral_t* ap = peripheral_named(slot, who);
+  if (ap == nullptr || ap->api->query == nullptr) {
+    return peripheral_error;
+  }
+  return ap->api->query(ap->instance, cmd_id, out, out_size);
+}
+
