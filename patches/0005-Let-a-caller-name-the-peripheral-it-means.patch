+TEST_CASE("Slot 0: naming the peripheral reaches it past an id it shares") {
+  TestConfig_t test_config(TestConfig_t::disk_ii_only());
+  HeadlessHarness_t harness(test_config);
+
+  // keyboard_query_rocker and JOY_QUERY_EXIT_EVENT are both id 2 and both
+  // answer a single byte, so size cannot separate them and a broadcast lands
+  // on whichever peripheral the slot holds first. Naming the peripheral is the
+  // only way to be sure which one answered.
+  const uint8_t rocker_on = 1;
+  REQUIRE(peripheral_command_by_id(0, "linapple.keyboard",
+                                   keyboard_cmd_set_rocker, &rocker_on,
+                                   sizeof(rocker_on)) == peripheral_ok);
+
+  uint8_t rocker = 0;
+  size_t rocker_size = sizeof(rocker);
+  REQUIRE(peripheral_query_by_id(0, "linapple.keyboard", keyboard_query_rocker,
+                                 &rocker, &rocker_size) == peripheral_ok);
+  CHECK(rocker == 1);
+
+  // The joystick's answer under the same id is its own, and it is the one that
+  // has never been wired up - what matters is that it is not the keyboard's.
+  uint8_t exit_event = 1;
+  size_t exit_size = sizeof(exit_event);
+  REQUIRE(peripheral_query_by_id(0, "linapple.joystick", JOY_QUERY_EXIT_EVENT,
+                                 &exit_event, &exit_size) == peripheral_ok);
+  CHECK(exit_event == 0);
+
+  // The id is the descriptor's id, not the human name that
+  // peripheral_save_state_by_name takes, and a peripheral that is not in the
+  // slot is an error rather than someone else's answer.
+  rocker = 0;
+  rocker_size = sizeof(rocker);
+  CHECK(peripheral_query_by_id(0, "Keyboard", keyboard_query_rocker, &rocker,
+                               &rocker_size) == peripheral_error);
+  CHECK(peripheral_query_by_id(0, "linapple.disk_II", keyboard_query_rocker,
+                               &rocker, &rocker_size) == peripheral_error);
+  CHECK(peripheral_command_by_id(0, "linapple.disk_II", keyboard_cmd_set_rocker,
+                                 &rocker_on,
+                                 sizeof(rocker_on)) == peripheral_error);
+
+  const uint8_t rocker_off = 0;
+  REQUIRE(peripheral_command_by_id(0, "linapple.keyboard",
+                                   keyboard_cmd_set_rocker, &rocker_off,
+                                   sizeof(rocker_off)) == peripheral_ok);
+}
