+
     const uint64_t started_as = screen_page_hash();
     uint64_t previous = started_as;
     uint64_t executed = 0;
@@ -809,7 +860,7 @@ auto dispatch(const std::string& cmd, const Json& params, const Json& request)
 
     while (spent < max_frames) {
       const auto chunk_started = std::chrono::steady_clock::now();
-      executed += step_frames(static_cast<uint32_t>(chunk), false);
+      executed += step_frames(static_cast<uint32_t>(chunk), deterministic);
       spent += chunk;
       if (duty_percent < 100) {
         const auto worked = std::chrono::steady_clock::now() - chunk_started;
@@ -840,6 +891,7 @@ auto dispatch(const std::string& cmd, const Json& params, const Json& request)
     result["cycles"] = executed;
     result["changed"] = changed;
     result["hash"] = previous;
+    result["deterministic"] = deterministic;
     result["mode"] = mode_name(system_state.mode);
     return make_ok(request, result);
   }
@@ -955,6 +1007,7 @@ auto dispatch(const std::string& cmd, const Json& params, const Json& request)
     save_state_save();
     Json result;
     result["path"] = std::string(save_state_get_filename());
+    add_disk_rewind_warning(&result);
     return make_ok(request, result);
   }
 
@@ -966,6 +1019,7 @@ auto dispatch(const std::string& cmd, const Json& params, const Json& request)
