index 3dc84784..e7b13ac2 100644
--- a/src/frontends/common/agent/AgentCommands.cpp
+++ b/src/frontends/common/agent/AgentCommands.cpp
@@ -205,10 +205,25 @@ auto memory_view_of(const Json& params, std::string* view) -> bool {
 
 // --- run control -----------------------------------------------------------
 
-// Runs exactly `frames` emulated frames and parks the machine again. Turbo and
-// the disk-driven full-speed path both multiply the cycles a single
-// linapple_run_frame() call consumes, so deterministic stepping disables them
-// for the duration and restores the caller's settings afterwards.
+// Runs `frames` emulated frames and parks the machine again.
+//
+// What a frame costs is not fixed. Turbo, and the full-speed path the core
+// takes by itself whenever a drive is spinning, both make one
+// linapple_run_frame() call run the frame's cycles a hundred times over. So
+// `deterministic` is not a tuning knob, it decides what the word "frame"
+// means in the request:
+//
+//   deterministic: one frame is one frame's cycles, every time. The run is
+//     reproducible and a frame count is a length of time -- which is what a
+//     recorded input has to be replayed against. A disk load is emulated at
+//     the speed an Apple II loaded disks.
+//
+//   not deterministic: a frame is up to a hundred frames while a drive is
+//     spinning or the host asked for turbo. Sitting through a boot takes a
+//     hundredth of the wall clock, and the frame count stops being a time.
+//
+// Either way the caller's turbo setting is put back: it belongs to the person
+// at the window, not to the command.
 auto step_frames(uint32_t frames, bool deterministic) -> uint64_t {
   const AppMode saved_mode = system_state.mode;
   const bool saved_turbo = linapple_get_turbo();
@@ -432,6 +447,34 @@ auto disk_status_json() -> Json {
   return result;
 }
 
+// What a save state does not carry.
+//
+// A state is the machine: memory, registers, where each drive's head is and
+// which image is in it. It is not the image. A program that writes to a disk
+// writes through to the file on the host, and loading a state afterwards winds
+// the machine back to before that write while the file stays written - the
+// machine goes on believing it is reading the disk it saw at save time, and
+// the two drift apart silently. That is how a character disk in this workspace
+// was destroyed once already.
+//
+// Nothing here can fix that; a state that carried whole disk images would be a
+// different feature with a different cost. What it can do is stop the mismatch
+// being invisible: every state command says which drives hold an image that
+// the rewind will not touch, so a client can refuse the combination, warn
+// about it, or write-protect the drive first.
+auto add_disk_rewind_warning(Json* result) -> void {
+  const Json drives = disk_status_json().at("drives");
+  Json at_risk = Json::array();
+  for (const Json& drive : drives) {
+    if (drive.at("loaded").get<bool>() &&
+        !drive.at("write_protected").get<bool>()) {
+      at_risk.push_back(drive.at("drive"));
+    }
+  }
+  (*result)["disks"] = drives;
+  (*result)["disks_not_rewound"] = at_risk;
+}
+
