+// --- the text screen, read off a real program -------------------------------
+
+namespace {
+
+// The agent's own reading of the screen, one row, with the trailing blanks
+// taken off the way the harness does so the two can be compared.
+auto agent_text_row(const Json& screen, int row) -> std::string {
+  std::string line = screen.at("lines").at(static_cast<size_t>(row))
+                         .get<std::string>();
+  while (!line.empty() && line.back() == ' ') {
+    line.pop_back();
+  }
+  return line;
+}
+
+auto agent_screen_holds(const Json& screen, const std::string& text) -> bool {
+  for (const Json& line : screen.at("lines")) {
+    if (line.get<std::string>().find(text) != std::string::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+TEST_CASE("Agent: screen_text reads what a real program printed") {
+  // Every other screen_text case writes the screen codes itself, which proves
+  // the addressing and nothing else: the game this workspace drives paints its
+  // own font into hi-res and never touches the text page, so the command has
+  // never been read off a program that was actually printing. Applesoft is in
+  // ROM and prints in exactly the way the command claims to read.
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  auto disk = TestFixtures::create_ephemeral("minimal.dsk");
+  harness.mount_disk(6, 0, disk);
+  harness.boot();
+  harness.run_frames(20);
+
+  harness.type_string("E000G\r", 4);  // into Applesoft from the monitor
+  harness.run_frames(20);
+  harness.type_string("HOME\r", 4);
+  harness.run_frames(20);
+
+  const std::string printed = "AGENT READS THIS";
+  harness.type_string("PRINT \"" + printed + "\"\r", 4);
+  harness.run_frames(20);
+
+  const Json screen = ok_result("screen_text");
+  CHECK(screen.at("columns").get<int>() == 40);
+  CHECK(screen.at("rows").get<int>() == 24);
+  CHECK(screen.at("text_mode").get<bool>() == true);
+  CHECK(screen.at("mixed").get<bool>() == false);
+  CHECK(agent_screen_holds(screen, printed));
+
+  // And row for row against the harness's own decoder, which reads the same
+  // cells by a different route. Two readings of one screen agreeing is worth
+  // more than either matching a constant this file chose.
+  for (int row = 0; row < 24; ++row) {
+    CHECK(agent_text_row(screen, row) == harness.get_text_row(row));
+  }
+}
+
+TEST_CASE("Agent: screen_text reads 80 columns off the firmware") {
+  // The 80-column case takes the even columns out of auxiliary memory and the
+  // odd ones out of main, and until now it had only ever been shown the bytes
+  // this file poked into those banks. PR#3 hands the screen to the //e's own
+  // 80-column firmware, which puts them there itself.
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  auto disk = TestFixtures::create_ephemeral("minimal.dsk");
+  harness.mount_disk(6, 0, disk);
+  harness.boot();
+  harness.run_frames(20);
+
+  harness.type_string("E000G\r", 4);
+  harness.run_frames(20);
+  harness.type_string("PR#3\r", 4);
+  harness.run_frames(60);
+
+  const std::string printed = "EIGHTY COLUMNS";
+  harness.type_string("PRINT \"" + printed + "\"\r", 4);
+  harness.run_frames(30);
+
+  const Json screen = ok_result("screen_text");
+  CHECK(screen.at("columns").get<int>() == 80);
+  CHECK(agent_screen_holds(screen, printed));
+}
+
 TEST_CASE("Agent: screen_hires hands back the page byte for byte") {
   TestConfig test_config(TestConfig::disk_ii_only());
   HeadlessHarness harness(test_config);
@@ -1464,6 +1556,78 @@ TEST_CASE("Agent: a deterministic run gives the turbo setting back") {
   CHECK(linapple_set_disk_turbo(true));
 }
 
+TEST_CASE("Agent: a frame is a length of time only if the run was asked to be") {
+  // The suite has always tested the deterministic path while every tool in the
+  // workspace but the TAS recorder passes deterministic=false, so what the
+  // path they use actually promises had never been written down. It is this:
+  // not much, and a hundred times not much.
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  select_text_page1();
+  run_program(0x0300, program_idle);
+
+  auto run = [](bool deterministic) -> uint64_t {
+    const Json result = ok_result(
+        "run_frames", {{"frames", 3}, {"deterministic", deterministic}});
+    // Which one it was is in the reply, so a caller counting frames as time
+    // can tell whether it got any.
+    CHECK(result.at("deterministic").get<bool>() == deterministic);
+    return result.at("cycles").get<uint64_t>();
+  };
+
+  ok_result("turbo_set", {{"turbo", false}});
+  const uint64_t exact = run(true);
+  REQUIRE(exact > 0);
+  // With nothing running fast there is nothing between them.
+  CHECK(run(false) == exact);
+
+  ok_result("turbo_set", {{"turbo", true}});
+  CHECK(run(true) == exact);
+
+  // And here is the difference the tools have been living with: the same three
+  // frames, asked for the same way, emulate a hundred times as much of the
+  // machine's life. Which is the point when what is being sat through is a
+  // disk load, and a trap when a frame count was meant as a duration - a wait
+  // of "sixty frames" for a game to redraw can pass six thousand frames of
+  // game time and walk straight past the screen it was waiting for.
+  const uint64_t hurried = run(false);
+  CHECK(hurried == exact * 100);
+
+  ok_result("turbo_set", {{"turbo", false}});
+}
+
+TEST_CASE("Agent: a wait runs flat out unless it is told not to") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  select_text_page1();
+  run_program(0x0300, program_idle);
+  ok_result("turbo_set", {{"turbo", true}});
+
+  // A wait defaults the other way from run_frames, because most of what is
+  // waited for is a disk load. The reply says so either way.
+  const Json hurried = ok_result("run_until_change", wait_params(48, 24));
+  CHECK(hurried.at("deterministic").get<bool>() == false);
+
+  Json exact_params = wait_params(48, 24);
+  exact_params["deterministic"] = true;
+  const Json exact = ok_result("run_until_change", exact_params);
+  CHECK(exact.at("deterministic").get<bool>() == true);
+
+  // Asked to be exact, a wait spends its budget in frames - the same cycles
+  // the same number of run_frames would have cost. Left alone under turbo it
+  // spends a hundred times that, which is why `max_frames` is a ceiling on
+  // round trips rather than on emulated time.
+  const uint64_t by_frames =
+      ok_result("run_frames", {{"frames", 48}, {"deterministic", true}})
+          .at("cycles")
+          .get<uint64_t>();
+  CHECK(exact.at("cycles").get<uint64_t>() == by_frames);
+  CHECK(hurried.at("cycles").get<uint64_t>() == by_frames * 100);
+
+  ok_result("turbo_set", {{"turbo", false}});
+  CHECK(ok_result("status").at("turbo").get<bool>() == false);
+}
+
