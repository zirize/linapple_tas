 TEST_CASE("Agent: a save state puts the machine back where it was") {
@@ -1550,6 +1714,92 @@ TEST_CASE("Agent: the same state and the same inputs run the same way") {
   CHECK(*mem_get_main_ptr(0x0400) != first.cell);
 }
 
+namespace {
+
+auto read_whole_file(const std::string& path) -> std::vector<uint8_t> {
+  std::ifstream file(path, std::ios::binary);
+  REQUIRE(file.good());
+  return std::vector<uint8_t>(std::istreambuf_iterator<char>(file),
+                              std::istreambuf_iterator<char>());
+}
+
+auto write_whole_file(const std::string& path, const std::vector<uint8_t>& data)
+    -> void {
+  std::ofstream file(path, std::ios::binary | std::ios::trunc);
+  REQUIRE(file.good());
+  file.write(reinterpret_cast<const char*>(data.data()),
+             static_cast<std::streamsize>(data.size()));
+}
+
+}  // namespace
+
+TEST_CASE("Agent: a state rewinds the machine and not the disk in the drive") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  StateFileFixture_t state_file;
+  auto disk = TestFixtures::create_ephemeral("minimal.dsk");
+  harness.mount_disk(6, 0, disk);
+  select_text_page1();
+  run_program(0x0300, program_draw_forever);
+
+  const Json saved = ok_result("state_save", {{"path", state_file.path}});
+  ok_result("run_frames", {{"frames", 8}});
+  const uint64_t moved_on = screen_hash();
+
+  // What a write by the running program reaches the host as is bytes in the
+  // image file. Booting a DOS to make one would be a slower way of arriving at
+  // the same two bytes, and what is under test is not the write - it is what a
+  // rewind afterwards does and does not put back.
+  std::vector<uint8_t> image = read_whole_file(disk.path());
+  REQUIRE(image.size() > 0x200);
+  const uint8_t before = image.at(0x100);
+  image.at(0x100) = static_cast<uint8_t>(before ^ 0xFF);
+  write_whole_file(disk.path(), image);
+
+  ok_result("state_load", {{"path", state_file.path}});
+
+  // The machine is back.
+  CHECK(screen_hash() != moved_on);
+  // The disk is not, and the drive still says it is holding the same image -
+  // which is the whole shape of the problem: nothing about the machine after
+  // the load says that what it is about to read has changed underneath it.
+  CHECK(read_whole_file(disk.path()).at(0x100) ==
+        static_cast<uint8_t>(before ^ 0xFF));
+  const Json status = ok_result("disk_status");
+  CHECK(status.at("drives").at(0).at("path").get<std::string>() ==
+        disk.path());
+
+  // So both state commands say which drives the rewind will not reach. A
+  // writable image in a drive is the combination that corrupted a character
+  // disk in this workspace, and a client can act on this: refuse it, warn, or
+  // write-protect the drive before offering to rewind.
+  for (const Json& reply : {saved, ok_result("state_load",
+                                             {{"path", state_file.path}})}) {
+    REQUIRE(reply.contains("disks_not_rewound"));
+    const std::vector<int> at_risk =
+        reply.at("disks_not_rewound").get<std::vector<int>>();
+    CHECK(at_risk == std::vector<int>{0});
+    CHECK(reply.at("disks").at(0).at("path").get<std::string>() ==
+          disk.path());
+  }
+
+  // Write-protected, there is nothing to warn about: the machine cannot change
+  // the image, so a rewind cannot end up disagreeing with one. Which is the
+  // remedy as much as the check - a tool that wants to rewind freely can put
+  // the disk in read-only and stop worrying about it.
+  ok_result("disk_insert",
+            {{"drive", 0}, {"path", disk.path()}, {"write_protected", true}});
+  ok_result("run_frames", {{"frames", 1}});
+  REQUIRE(ok_result("disk_status")
+              .at("drives")
+              .at(0)
+              .at("write_protected")
+              .get<bool>());
+  CHECK(ok_result("state_save", {{"path", state_file.path}})
+            .at("disks_not_rewound")
+            .empty());
+}
