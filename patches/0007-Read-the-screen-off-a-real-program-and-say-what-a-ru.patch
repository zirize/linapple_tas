     const uint64_t executed =
-        step_frames(static_cast<uint32_t>(frames),
-                    param_bool(params, "deterministic", true));
+        step_frames(static_cast<uint32_t>(frames), deterministic);
     Json result;
     result["frames"] = frames;
     result["cycles"] = executed;
+    result["deterministic"] = deterministic;
     result["mode"] = mode_name(system_state.mode);
     return make_ok(request, result);
   }
@@ -787,6 +831,13 @@ auto dispatch(const std::string& cmd, const Json& params, const Json& request)
       return make_error(request, "max_frames or chunk out of range");
     }
 
+    // A wait is the one place where running flat out is usually what the
