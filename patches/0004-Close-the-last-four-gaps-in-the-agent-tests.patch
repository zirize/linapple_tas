 // --- save states and repeating a run ---------------------------------------
 
 TEST_CASE("Agent: a save state puts the machine back where it was") {
@@ -1118,6 +1310,49 @@ TEST_CASE("Agent server: a request line past the cap drops the client") {
   CHECK(agent_server_client_count() == 0);
 }
 
+TEST_CASE("Agent server: two clients are answered separately") {
+  AgentSocketFixture_t socket_fixture;
+  socket_fixture.start();
+  socket_fixture.connect_client();
+  const int second = socket_fixture.open_client();
+  CHECK(agent_server_client_count() == 2);
+
+  // Each connection carries its own request and gets its own reply: a session
+  // a person is watching while a tool drives it is two clients, and an answer
+  // delivered to the wrong one is worse than no answer.
+  socket_fixture.send_raw(socket_fixture.fd, "{\"id\":11,\"cmd\":\"ping\"}\n");
+  socket_fixture.send_raw(second, "{\"id\":22,\"cmd\":\"status\"}\n");
+
+  const std::vector<std::string> first_replies =
+      socket_fixture.collect_replies(socket_fixture.fd, 1);
+  const std::vector<std::string> second_replies =
+      socket_fixture.collect_replies(second, 1);
+  REQUIRE(first_replies.size() == 1);
+  REQUIRE(second_replies.size() == 1);
+
+  const Json first = Json::parse(first_replies.at(0), nullptr, false);
+  const Json other = Json::parse(second_replies.at(0), nullptr, false);
+  REQUIRE_FALSE(first.is_discarded());
+  REQUIRE_FALSE(other.is_discarded());
+  CHECK(first.at("id").get<int>() == 11);
+  CHECK(other.at("id").get<int>() == 22);
+  CHECK(first.at("ok").get<bool>());
+  CHECK(other.at("result").contains("mode"));
+
+  // One client leaving does not take the other with it.
+  close(second);
+  agent_server_poll(0);
+  CHECK(agent_server_client_count() == 1);
+
+  socket_fixture.send_raw(socket_fixture.fd, "{\"id\":33,\"cmd\":\"ping\"}\n");
+  const std::vector<std::string> after =
+      socket_fixture.collect_replies(socket_fixture.fd, 1);
+  REQUIRE(after.size() == 1);
+  const Json still = Json::parse(after.at(0), nullptr, false);
+  REQUIRE_FALSE(still.is_discarded());
+  CHECK(still.at("id").get<int>() == 33);
+}
+
 TEST_CASE("Agent server: stopping releases the socket path") {
   AgentSocketFixture_t socket_fixture;
   socket_fixture.start();
