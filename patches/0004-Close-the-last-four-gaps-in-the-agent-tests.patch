+// --- what the screen commands hand back ------------------------------------
+
+TEST_CASE("Agent: screen_text reads 80 columns out of both banks") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  select_text_page1();
+  touch_switch(0xC00D);  // 80 columns
+  REQUIRE(video_get_sw_80col());
+
+  // In 80-column text each pair of columns shares one address: the even column
+  // is the auxiliary bank's byte, the odd one is main memory's. Reading only
+  // main would give 40 columns of the wrong half.
+  const uint16_t row0 = 0x0400;
+  for (int pair = 0; pair < 5; ++pair) {
+    poke_aux(static_cast<uint16_t>(row0 + pair),
+             static_cast<uint8_t>(0xC1 + pair));  // A B C D E
+    poke(static_cast<uint16_t>(row0 + pair),
+         static_cast<uint8_t>(0xB1 + pair));  // 1 2 3 4 5
+  }
+
+  const Json result = ok_result("screen_text");
+  CHECK(result.at("columns").get<int>() == 80);
+  CHECK(result.at("rows").get<int>() == 24);
+  const std::string first = result.at("lines").at(0).get<std::string>();
+  REQUIRE(first.size() == 80);
+  CHECK(first.substr(0, 10) == "A1B2C3D4E5");
+
+  // And back to 40 columns, where the same row is main memory alone.
+  touch_switch(0xC00C);
+  const Json narrow = ok_result("screen_text");
+  CHECK(narrow.at("columns").get<int>() == 40);
+  CHECK(narrow.at("lines").at(0).get<std::string>().substr(0, 5) == "12345");
+}
+
+TEST_CASE("Agent: screen_hires hands back the page byte for byte") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+
+  // A pattern rather than a constant: a decoder that drops or reorders bytes
+  // passes a run of identical ones.
+  for (size_t i = 0; i < 0x2000; ++i) {
+    poke(static_cast<uint16_t>(0x2000 + i),
+         static_cast<uint8_t>((i * 7) & 0xFF));
+  }
+  poke(0x2000, 0xFF);
+  poke(0x3FFF, 0x80);
+
+  const Json result = ok_result("screen_hires", {{"page", 1}});
+  CHECK(result.at("addr").get<int>() == 0x2000);
+  CHECK(result.at("len").get<int>() == 0x2000);
+  const std::vector<uint8_t> data =
+      base64_decode(result.at("data").get<std::string>());
+  REQUIRE(data.size() == 0x2000);
+  CHECK(data.front() == 0xFF);
+  CHECK(data.back() == 0x80);
+  bool matches = true;
+  for (size_t i = 1; i + 1 < data.size(); ++i) {
+    if (data.at(i) != static_cast<uint8_t>((i * 7) & 0xFF)) {
+      matches = false;
+      break;
+    }
+  }
+  CHECK(matches);
+
+  // Page 2 is a different 8 KB, and asking for it must not answer with page 1.
+  poke(0x4000, 0x11);
+  const std::vector<uint8_t> page2 = base64_decode(
+      ok_result("screen_hires", {{"page", 2}}).at("data").get<std::string>());
+  REQUIRE(page2.size() == 0x2000);
+  CHECK(page2.front() == 0x11);
+}
+
+TEST_CASE("Agent: screen_capture hands back the frame buffer as it stands") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  harness.run_frames(2);
+
+  const Json result = ok_result("screen_capture");
+  CHECK(result.at("format").get<std::string>() == "bgra8888");
+  const auto width = result.at("width").get<uint32_t>();
+  const auto height = result.at("height").get<uint32_t>();
+  CHECK(width == video_width);
+  CHECK(height == video_height);
+
+  const std::vector<uint8_t> data =
+      base64_decode(result.at("data").get<std::string>());
+  REQUIRE(data.size() ==
+          static_cast<size_t>(width) * height * sizeof(uint32_t));
+
+  const uint32_t* pixels = video_get_output_buffer();
+  REQUIRE(pixels != nullptr);
+  const auto* bytes = reinterpret_cast<const uint8_t*>(pixels);
+  bool same = true;
+  for (size_t i = 0; i < data.size(); ++i) {
+    if (data.at(i) != bytes[i]) {
+      same = false;
+      break;
+    }
+  }
+  CHECK(same);
+}
+
+// --- what a run does to the machine's settings ------------------------------
+
+TEST_CASE("Agent: a deterministic run gives the turbo setting back") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  select_text_page1();
+  run_program(0x0300, program_idle);
+
+  ok_result("turbo_set", {{"turbo", true}});
+  REQUIRE(ok_result("status").at("turbo").get<bool>());
+
+  const Json params = {{"frames", 3}, {"deterministic", true}};
+  const uint64_t hot =
+      ok_result("run_frames", params).at("cycles").get<uint64_t>();
+  // Turbo is the host's business, not the machine's, so a run that turns it
+  // off to stay reproducible has to put it back or the next thing the person
+  // does at the window runs at the wrong speed.
+  CHECK(ok_result("status").at("turbo").get<bool>());
+  CHECK(ok_result("status").at("mode").get<std::string>() == "paused");
+
+  ok_result("turbo_set", {{"turbo", false}});
+  const uint64_t cold =
+      ok_result("run_frames", params).at("cycles").get<uint64_t>();
+  CHECK_FALSE(ok_result("status").at("turbo").get<bool>());
+
+  // Which is the point of asking for a deterministic run: the same frames cost
+  // the same cycles whatever the host was set to.
+  CHECK(hot == cold);
+
+  // A run that did not ask for determinism leaves the setting alone as well.
+  ok_result("turbo_set", {{"turbo", true}});
+  ok_result("run_frames", {{"frames", 1}, {"deterministic", false}});
+  CHECK(ok_result("status").at("turbo").get<bool>());
+  ok_result("turbo_set", {{"turbo", false}});
+
+  // Disk turbo is the user's setting too, and a deterministic run turns it off
+  // for the same reason: a spinning drive would multiply a frame's cycles.
+  linapple_set_disk_turbo(true);
+  ok_result("run_frames", params);
+  CHECK(linapple_set_disk_turbo(true));
+}
