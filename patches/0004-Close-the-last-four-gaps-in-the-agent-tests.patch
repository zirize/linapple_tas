+// The commands that hand back memory do it as base64, so a test that wants to
+// check the bytes has to undo that. Enough of a decoder for a well-formed
+// payload, which is all the agent produces.
+auto base64_decode(const std::string& text) -> std::vector<uint8_t> {
+  static const std::string alphabet =
+      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  std::vector<uint8_t> out;
+  uint32_t bits = 0;
+  int have = 0;
+  for (const char c : text) {
+    if (c == '=') {
+      break;
+    }
+    const size_t index = alphabet.find(c);
+    if (index == std::string::npos) {
+      continue;
+    }
+    bits = (bits << 6) | static_cast<uint32_t>(index);
+    have += 6;
+    if (have >= 8) {
+      have -= 8;
+      out.push_back(static_cast<uint8_t>((bits >> have) & 0xFFU));
+    }
+  }
+  return out;
+}
+
+auto poke_aux(uint16_t address, uint8_t value) -> void {
+  uint8_t* cell = mem_get_aux_ptr(address);
+  REQUIRE(cell != nullptr);
+  *cell = value;
+}
+
 auto poke(uint16_t address, uint8_t value) -> void {
   uint8_t* cell = mem_get_main_ptr(address);
   REQUIRE(cell != nullptr);
@@ -270,20 +303,29 @@ struct AgentSocketFixture_t {
     REQUIRE(agent_server_is_active());
   }
 
-  auto connect_client() -> void {
-    fd = socket(AF_UNIX, SOCK_STREAM, 0);
-    REQUIRE(fd >= 0);
+  // Opens another connection to the same socket and hands back its fd. The
+  // server is meant to hold more than one client - a person watching a session
+  // while a tool drives it is two - so a test needs to be able to be both.
+  auto open_client() -> int {
+    const int client = socket(AF_UNIX, SOCK_STREAM, 0);
+    REQUIRE(client >= 0);
     sockaddr_un addr = {};
     addr.sun_family = AF_UNIX;
     std::memcpy(static_cast<void*>(addr.sun_path), path.c_str(),
                 path.size() + 1);
-    REQUIRE(connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) == 0);
+    REQUIRE(connect(client, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) ==
+            0);
     // Non-blocking on this side too: the server drains only when the test
     // pumps it, so a blocking write of a large request would deadlock against
     // a test that is waiting to make that very call.
-    const int flags = fcntl(fd, F_GETFL, 0);
-    REQUIRE(fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0);
+    const int flags = fcntl(client, F_GETFL, 0);
+    REQUIRE(fcntl(client, F_SETFL, flags | O_NONBLOCK) == 0);
     agent_server_poll(0);
+    return client;
+  }
+
+  auto connect_client() -> void {
+    fd = open_client();
     REQUIRE(agent_server_client_count() == 1);
   }
 
@@ -294,11 +336,13 @@ struct AgentSocketFixture_t {
     }
   }
 
-  auto send_raw(const std::string& payload) -> void {
+  auto send_raw(const std::string& payload) -> void { send_raw(fd, payload); }
+
+  auto send_raw(int client, const std::string& payload) -> void {
     size_t sent = 0;
     while (sent < payload.size()) {
-      const ssize_t written =
-          send(fd, payload.data() + sent, payload.size() - sent, MSG_NOSIGNAL);
+      const ssize_t written = send(client, payload.data() + sent,
