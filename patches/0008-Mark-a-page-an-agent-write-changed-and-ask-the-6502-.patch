index a1349e7..2c60787 100644
--- a/src/frontends/common/agent/AgentCommands.cpp
+++ b/src/frontends/common/agent/AgentCommands.cpp
@@ -164,6 +164,30 @@ auto memory_view_ptr(const std::string& view, uint16_t address) -> uint8_t* {
   return mem_get_main_ptr(address);
 }
 
+// Writes one byte through the view the caller asked for, and says whether it
+// landed anywhere.
+//
+// The marking is not an optimisation. When the page a write lands on is the
+// one currently mapped in, the byte goes into the live image rather than into
+// the bank's own store, and the next soft switch copies the page back to its
+// bank only if something says the page changed. The CPU says so for its own
+// writes. A write that arrives over the socket has no CPU behind it, so
+// without this a cheat holds until the game next flips a bank -- which for a
+// game keeping its data in the language card is a fraction of a second -- and
+// then the old byte comes back with nothing to show that it did.
+auto memory_view_write(const std::string& view, uint16_t address, uint8_t value)
+    -> bool {
+  uint8_t* target = memory_view_ptr(view, address);
+  if (target == nullptr) {
+    return false;
+  }
+  *target = value;
+  if (target == get_mem_ptr(address)) {
+    mem_mark_dirty(address);
+  }
+  return true;
+}
+
 // Reads the view a memory command asked for, defaulting to what the old
