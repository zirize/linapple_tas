 src/apple2/Memory.cpp                        |  15 +
 src/apple2/Memory.h                          |   1 +
 src/frontends/common/agent/AgentCommands.cpp |  29 +-
 tests/test_agent_commands.cpp                | 277 +++++++++++++++++++
 4 files changed, 318 insertions(+), 4 deletions(-)

diff --git a/src/apple2/Memory.cpp b/src/apple2/Memory.cpp
index b10cf32..3b05fc3 100644
--- a/src/apple2/Memory.cpp
+++ b/src/apple2/Memory.cpp
@@ -1045,6 +1045,21 @@ auto mem_get_cx_rom_peripheral() -> uint8_t* {
 
 auto get_mem_ptr(uint16_t addr) -> uint8_t* { return mem + addr; }
 
+// Says that the page holding `addr` has been changed in the live image.
+//
+// The live image is not where a byte finally lives: every soft switch that
+// moves a page copies it back to the bank it belongs to, and it copies it back
+// only if this flag says something changed. Nothing changed, nothing is
+// copied, and the bank's older byte is copied in over the edit instead. The
+// CPU sets this on every write it makes; anything that reaches around the CPU
+// and edits `mem` -- the debugger, a program loader, a control channel -- has
+// to say so too, or its edit lasts only until the next switch.
+auto mem_mark_dirty(uint16_t addr) -> void {
+  if (memdirty != nullptr) {
+    memdirty[addr >> 8] = 0xFF;
+  }
+}
+
