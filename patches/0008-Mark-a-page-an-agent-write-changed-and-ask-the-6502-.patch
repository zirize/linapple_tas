@@ -713,10 +737,7 @@ auto dispatch(const std::string& cmd, const Json& params, const Json& request)
     for (size_t i = 0; i < bytes.size(); ++i) {
       const auto address =
           static_cast<uint16_t>(addr + static_cast<int64_t>(i));
-      uint8_t* target = memory_view_ptr(view, address);
-      if (target != nullptr) {
-        *target = bytes.at(i);
-      }
+      memory_view_write(view, address, bytes.at(i));
     }
     Json result;
     result["written"] = bytes.size();
