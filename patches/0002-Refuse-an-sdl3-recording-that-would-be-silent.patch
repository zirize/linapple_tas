From 0d5f4b2d562caa85e40870d3b03f62ee99120038 Mon Sep 17 00:00:00 2001
From: zirize <zirize@gmail.com>
Date: Fri, 18 Sep 2026 13:58:31 +0900
Subject: [PATCH 2/8] Refuse an sdl3 recording that would be silent

The mixer's samples reach the dumper from the sound card's callback, so a
session that never opened a device would write a WAV of nothing at all,
and a silent file cannot be told apart from a machine that made no sound.
That is already why the frontends with no audio path of their own refuse
outright; the SDL3 frontend without a device is the same case.

frontend_audio_dump_start now says no when there is no stream, and ds_init
opens the device before initialising the dumper, so a file named with
--audio-dump is reported as not recorded instead of being created empty.

Checked both ways: with a device, two seconds of audio_dump wrote 360,492
bytes; with SDL_OpenAudioDeviceStream made to fail, the command answered
ok:false and the command line printed "audio: no device, not recording
to ..." - neither left a file behind.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/frontends/sdl3/Main.cpp | 30 +++++++++++++++++++++++++-----
 1 file changed, 25 insertions(+), 5 deletions(-)

diff --git a/src/frontends/sdl3/Main.cpp b/src/frontends/sdl3/Main.cpp
index 051be03c..68d6c787 100644
--- a/src/frontends/sdl3/Main.cpp
+++ b/src/frontends/sdl3/Main.cpp
@@ -7,6 +7,7 @@
 #include <array>
 #include <cstddef>
 #include <cstdint>
+#include <cstdio>
 #include <string>
 #include <vector>
 
@@ -30,6 +31,9 @@ namespace {
 SdlAudioStreamPtr audio_stream;
 std::string audio_dump_file;
 AudioDumper audio_dumper;
+// The device's rate, kept because a recording started later has to be written
+// at the rate the callback is actually fed at.
+uint32_t device_rate_hz = 0;
 
 auto SDLCALL sdl3_audio_callback(void* userdata, SDL_AudioStream* stream,
                                  int additional_amount, int total_amount)
@@ -65,15 +69,23 @@ auto SDLCALL sdl3_audio_callback(void* userdata, SDL_AudioStream* stream,
 
 // Starting and stopping the recording while the machine runs, rather than only
 // from the command line. What is dumped here is the mixer's output - the same
-// thing the sound card is playing, Mockingboard included - which is not quite
-// what the headless frontend writes, where there is no mixer and the samples
-// come straight from the speaker.
+// thing the sound card is playing - taken at the device's rate. The headless
+// frontend records the same mixer, but pulled on emulated time rather than by
+// a device, which is the difference the timing note in the documentation is
+// about.
 auto frontend_audio_dump_start(const char* path) -> bool {
   if (path == nullptr || *path == '\0') {
     return false;
   }
+  // Samples reach the dumper from the sound card's callback and nowhere else,
+  // so with no device open the file would stay silent. Refusing is the same
+  // answer the frontends without an audio path give: a silent file cannot be
+  // told apart from a machine that made no sound.
+  if (audio_stream == nullptr) {
+    return false;
+  }
   frontend_audio_dump_stop();
-  if (audio_dumper_initialize(&audio_dumper, path, 44100, 2) != 0) {
+  if (audio_dumper_initialize(&audio_dumper, path, device_rate_hz, 2) != 0) {
     return false;
   }
   audio_dump_file = path;
@@ -118,13 +130,21 @@ auto ds_init() -> bool {
       SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &desired,
                                 sdl3_audio_callback, nullptr));
   if (audio_stream == nullptr) {
+    // Same reason as above: the command line asked for a recording we cannot
+    // fill, so say so rather than leave an empty WAV behind.
+    if (!audio_dump_file.empty()) {
+      fprintf(stderr, "audio: no device, not recording to %s\n",
+              audio_dump_file.c_str());
+      audio_dump_file.clear();
+    }
     return false;
   }
 
   // SDL3 honours the stream's source spec exactly, so what was asked for is
   // what the callback is fed.
-  const auto device_rate_hz = static_cast<uint32_t>(device_rate);
+  device_rate_hz = static_cast<uint32_t>(device_rate);
 
+  // Only once the device is open, because that callback is what fills it.
   if (!audio_dump_file.empty()) {
     audio_dumper_initialize(&audio_dumper, audio_dump_file.c_str(),
                             device_rate_hz, 2);
-- 
