From f4b13be878747749b0493965cae656fb5ec37684 Mon Sep 17 00:00:00 2001
From: zirize <zirize@gmail.com>
Date: Fri, 18 Sep 2026 14:27:23 +0900
Subject: [PATCH 4/9] Stop slot 0 peripherals answering each other's commands

Slot 0 holds the keyboard, the joystick and the speaker, a command is offered
to every peripheral in the slot, and the ids overlap from 1 to 4. Only the
payload size stands between them, and two of those collisions were live:

  * The keyboard's rocker switch is id 3, and so is JOY_CMD_RESET, which
    checked nothing at all. Flipping the rocker centred both sticks, dropped
    the buttons and cleared the trim. The SDL and TUI frontends all reach it.
  * Applying a joystick configuration is id 4, and the keyboard's set-mods is
    too. The keyboard asked only that the payload be big enough, so a 56-byte
    config was read as modifiers: the first joystick type byte landed on shift
    and the second on caps lock, holding shift down for the machine.
  * Latent, with no sender today: a joystick trim is id 2 and the keyboard's
    set-caps accepted it, so a trim would have toggled caps lock.

The fix is the one the joystick already had: ask for exactly the payload, not
merely enough of one. JOY_CMD_RESET now requires an empty payload, and the
keyboard's commands require their own sizes.

Queries have the same overlap, and there the first peripheral in the slot
answers. JOY_QUERY_CONFIG was being answered by the keyboard with five
modifier bytes, because 56 bytes of room passes a "big enough" test. A query
now stands aside when the buffer is not the size of its own answer, while a
buffer too small for it stays an error - that is a caller who did mean this
query. Which peripheral is first is static initialisation order, so leaning on
it was never safe.

What size cannot settle: the keyboard's rocker query and JOY_QUERY_EXIT_EVENT
are both id 2 and both answer one byte. Nothing outside the joystick asks for
the exit event today, and the note in both files says so. Telling those apart
needs per-peripheral id namespaces, which is an ABI change.

Four cases cover the collisions in tests/test_agent_commands.cpp (36 to 40).

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 src/apple2/peripherals/joystick/Joystick.cpp | 19 +++-
 src/apple2/peripherals/keyboard/Keyboard.cpp | 39 ++++++--
 tests/test_agent_commands.cpp                | 97 ++++++++++++++++++++
 3 files changed, 146 insertions(+), 9 deletions(-)

diff --git a/src/apple2/peripherals/joystick/Joystick.cpp b/src/apple2/peripherals/joystick/Joystick.cpp
index 85840ca..644ea20 100644
--- a/src/apple2/peripherals/joystick/Joystick.cpp
+++ b/src/apple2/peripherals/joystick/Joystick.cpp
@@ -274,11 +274,17 @@ static auto joystick_abi_command(void* instance, uint32_t cmd, const void* data,
       return peripheral_ok;
     }
     case JOY_CMD_RESET: {
+      // This command carries nothing, and every sender passes nothing. Saying
+      // so is what keeps it from firing on the keyboard's id 3 - setting the
+      // rocker switch - which used to centre both sticks and drop the buttons.
+      if (size != 0) {
+        return peripheral_error;
+      }
       joystick_abi_reset(instance);
       return peripheral_ok;
     }
     case JOY_CMD_SET_CONFIG: {
-      if (data == nullptr || size < sizeof(JoystickConfig_t)) {
+      if (data == nullptr || size != sizeof(JoystickConfig_t)) {
         return peripheral_error;
       }
       std::memcpy(&joystick_peripheral->config, data, sizeof(JoystickConfig_t));
@@ -307,6 +313,12 @@ static auto joystick_abi_query(void* instance, uint32_t cmd, void* out,
       if (instance == nullptr || *size < required_size) {
         return peripheral_error;
       }
+      // The keyboard holds id 1 too (keyboard_query_mods, 8 bytes). A buffer
+      // with room to spare was cut for someone else's answer, so step aside
+      // rather than fill it with a config.
+      if (*size != required_size) {
+        return peripheral_incompatible;
+      }
       const auto* joystick_peripheral =
           static_cast<const JoystickPeripheral_t*>(instance);
       std::memcpy(out, &joystick_peripheral->config, required_size);
@@ -322,6 +334,11 @@ static auto joystick_abi_query(void* instance, uint32_t cmd, void* out,
       if (instance == nullptr || *size < required_size) {
         return peripheral_error;
       }
+      // keyboard_query_rocker is id 2 and also answers one byte, so size
+      // cannot tell these apart - see the note there.
+      if (*size != required_size) {
+        return peripheral_incompatible;
+      }
       const auto* joystick_peripheral =
           static_cast<const JoystickPeripheral_t*>(instance);
       *static_cast<uint8_t*>(out) = joystick_peripheral->has_quit_event ? 1 : 0;
diff --git a/src/apple2/peripherals/keyboard/Keyboard.cpp b/src/apple2/peripherals/keyboard/Keyboard.cpp
index 5b90905..dcb3a9a 100644
--- a/src/apple2/peripherals/keyboard/Keyboard.cpp
+++ b/src/apple2/peripherals/keyboard/Keyboard.cpp
@@ -480,7 +480,11 @@ auto keyboard_abi_command(void* instance, uint32_t cmd_id, const void* data,
 
   switch (static_cast<KeyboardCmd_t>(cmd_id)) {
     case keyboard_cmd_event: {
-      if (size < sizeof(KeyboardEvent_t)) {
+      // Exactly this payload, not merely enough of one. Slot 0 is shared and
+      // the ids overlap - a joystick config is also id 4, a trim is also id 2 -
+      // so a command meant for the other peripheral arrives here too, and a
+      // length test that accepts anything larger reads it as a key event.
+      if (size != sizeof(KeyboardEvent_t)) {
         return peripheral_error;
       }
       const auto* ev = static_cast<const KeyboardEvent_t*>(data);
@@ -541,21 +545,21 @@ auto keyboard_abi_command(void* instance, uint32_t cmd_id, const void* data,
       return peripheral_ok;
     }
     case keyboard_cmd_set_caps: {
-      if (size < sizeof(uint8_t)) {
+      if (size != sizeof(uint8_t)) {
         return peripheral_error;
       }
       kp->logic.caps_lock = (*static_cast<const uint8_t*>(data) != 0);
       return peripheral_ok;
     }
     case keyboard_cmd_set_rocker: {
-      if (size < sizeof(uint8_t)) {
+      if (size != sizeof(uint8_t)) {
         return peripheral_error;
       }
       kp->logic.rocker_switch = (*static_cast<const uint8_t*>(data) != 0);
       return peripheral_ok;
     }
     case keyboard_cmd_set_mods: {
-      if (size < sizeof(KeyboardModifiers_t)) {
+      if (size != sizeof(KeyboardModifiers_t)) {
         return peripheral_error;
       }
       const auto* mods = static_cast<const KeyboardModifiers_t*>(data);
@@ -570,14 +574,14 @@ auto keyboard_abi_command(void* instance, uint32_t cmd_id, const void* data,
       return peripheral_ok;
     }
     case keyboard_cmd_set_layout: {
-      if (size < sizeof(uint8_t)) {
+      if (size != sizeof(uint8_t)) {
         return peripheral_error;
       }
       kp->logic.alternate_layout = *static_cast<const uint8_t*>(data);
       return peripheral_ok;
     }
     case keyboard_cmd_set_custom_key: {
-      if (size < sizeof(KeyboardCustomKeyPayload_t)) {
+      if (size != sizeof(KeyboardCustomKeyPayload_t)) {
         return peripheral_error;
       }
       const auto* payload =
@@ -593,6 +597,9 @@ auto keyboard_abi_command(void* instance, uint32_t cmd_id, const void* data,
       return peripheral_ok;
     }
     case keyboard_cmd_clear_custom_keys: {
+      if (size != 0) {
+        return peripheral_error;  // id 7 with a payload is not this command
+      }
       kp->logic.has_custom_keys = false;
       std::memset(kp->logic.custom_map, 0, sizeof(kp->logic.custom_map));
       std::memset(kp->logic.custom_shift_map, 0,
@@ -603,7 +610,7 @@ auto keyboard_abi_command(void* instance, uint32_t cmd_id, const void* data,
       return peripheral_ok;
     }
     case keyboard_cmd_set_auto_repeat: {
-      if (size < sizeof(uint8_t)) {
+      if (size != sizeof(uint8_t)) {
         return peripheral_error;
       }
       kp->logic.auto_repeat_enabled = (*static_cast<const uint8_t*>(data) != 0);
@@ -719,7 +726,14 @@ auto keyboard_abi_query(void* instance, uint32_t cmd_id, void* out,
         return peripheral_ok;
       }
       if (*out_size < sizeof(KeyboardModifiers_t)) {
-        return peripheral_error;
+        return peripheral_error;  // too small: asked for this, cannot hold it
+      }
+      // Room to spare means the buffer was cut for another peripheral's answer
+      // under the same id - JOY_QUERY_CONFIG is 1 too, and 56 bytes wide.
+      // Standing aside lets the query reach it; answering would hand the
+      // caller five modifier bytes where it expected a joystick config.
+      if (*out_size != sizeof(KeyboardModifiers_t)) {
+        return peripheral_incompatible;
       }
       auto* mods = static_cast<KeyboardModifiers_t*>(out);
       mods->shift = kp->logic.shift_key ? 1U : 0U;
@@ -738,6 +752,9 @@ auto keyboard_abi_query(void* instance, uint32_t cmd_id, void* out,
       if (*out_size < sizeof(KeyboardTranslate_t)) {
         return peripheral_error;
       }
+      if (*out_size != sizeof(KeyboardTranslate_t)) {
+        return peripheral_incompatible;
+      }
       auto* request = static_cast<KeyboardTranslate_t*>(out);
       uint32_t key = 0;
       request->latched =
@@ -754,6 +771,12 @@ auto keyboard_abi_query(void* instance, uint32_t cmd_id, void* out,
       if (*out_size < sizeof(uint8_t)) {
         return peripheral_error;
       }
+      // Size cannot settle this one: JOY_QUERY_EXIT_EVENT is id 2 as well and
+      // its answer is a byte too, so whichever peripheral the slot happens to
+      // hold first answers both. Only per-peripheral ids fix that.
+      if (*out_size != sizeof(uint8_t)) {
+        return peripheral_incompatible;
+      }
       *static_cast<uint8_t*>(out) = kp->logic.rocker_switch ? 1U : 0U;
       *out_size = sizeof(uint8_t);
       return peripheral_ok;
diff --git a/tests/test_agent_commands.cpp b/tests/test_agent_commands.cpp
index 93fc102..b8d21a6 100644
--- a/tests/test_agent_commands.cpp
+++ b/tests/test_agent_commands.cpp
@@ -974,6 +974,103 @@ TEST_CASE("Agent: the input commands check their sizes") {
   agent_input_set_capture(false, 0);
 }
 
+// --- slot 0 shares one id space ---------------------------------------------
+
+namespace {
+
+// Slot 0 holds the keyboard, the joystick and the speaker, and a command is
+// offered to every peripheral in the slot. The ids overlap, so what keeps a
+// command from being read by the wrong peripheral is the payload size - these
+// cases send each colliding id and check the other peripheral did not move.
+auto keyboard_mods() -> KeyboardModifiers_t {
+  KeyboardModifiers_t mods = {};
+  size_t size = sizeof(mods);
+  REQUIRE(peripheral_query(0, keyboard_query_mods, &mods, &size) ==
+          peripheral_ok);
+  return mods;
+}
+
+}  // namespace
+
+TEST_CASE("Slot 0: a joystick config does not hold down shift") {
+  TestConfig_t test_config(TestConfig_t::disk_ii_only());
+  HeadlessHarness_t harness(test_config);
+
+  // From a known state: the keyboard's flags outlive a harness.
+  const uint8_t caps_off = 0;
+  REQUIRE(peripheral_command(0, keyboard_cmd_set_caps, &caps_off,
+                             sizeof(caps_off)) == peripheral_ok);
+  peripheral_manager_think(0);
+
+  JoystickConfig_t config = {};
+  config.joy_type[0] = 1;  // read as KeyboardModifiers_t::shift
+  config.joy_type[1] = 1;  // read as KeyboardModifiers_t::caps
+  REQUIRE(peripheral_command(0, JOY_CMD_SET_CONFIG, &config, sizeof(config)) ==
+          peripheral_ok);
+  peripheral_manager_think(0);
+
+  const KeyboardModifiers_t mods = keyboard_mods();
+  CHECK(mods.shift == 0);
+  CHECK(mods.caps == 0);
+}
+
+TEST_CASE("Slot 0: flipping the rocker switch leaves the sticks alone") {
+  TestConfig_t test_config(TestConfig_t::disk_ii_only());
+  HeadlessHarness_t harness(test_config);
+
+  ok_result("joy_axis", {{"axis", 0}, {"value", 0}});
+  ok_result("joy_button", {{"button", 0}, {"down", true}});
+  REQUIRE(joystick_state().x_pos[0] == 0);
+
+  const uint8_t rocker = 1;
+  REQUIRE(peripheral_command(0, keyboard_cmd_set_rocker, &rocker,
+                             sizeof(rocker)) == peripheral_ok);
+  peripheral_manager_think(0);
+
+  // JOY_CMD_RESET is id 3 as well, and a reset would centre the stick and drop
+  // the button.
+  CHECK(joystick_state().x_pos[0] == 0);
+  CHECK(joystick_state().buttons[0] == 1);
+}
+
+TEST_CASE("Slot 0: a joystick trim does not toggle caps lock") {
+  TestConfig_t test_config(TestConfig_t::disk_ii_only());
+  HeadlessHarness_t harness(test_config);
+
+  // From a known state: the keyboard's caps flag outlives a harness.
+  const uint8_t caps_off = 0;
+  REQUIRE(peripheral_command(0, keyboard_cmd_set_caps, &caps_off,
+                             sizeof(caps_off)) == peripheral_ok);
+  peripheral_manager_think(0);
+  REQUIRE(keyboard_mods().caps == 0);
+  const JoystickTrimPayload_t trim = {true, 40};
+  REQUIRE(peripheral_command(0, JOY_CMD_SET_TRIM, &trim, sizeof(trim)) ==
+          peripheral_ok);
+  peripheral_manager_think(0);
+
+  CHECK(keyboard_mods().caps == 0);
+}
+
+TEST_CASE("Slot 0: a query is answered by the peripheral that owns the id") {
+  TestConfig_t test_config(TestConfig_t::disk_ii_only());
+  HeadlessHarness_t harness(test_config);
+
+  // keyboard_query_mods and JOY_QUERY_CONFIG are both id 1, and the first
+  // peripheral in the slot gets asked first. The buffer size is the only thing
+  // that says which answer was wanted.
+  JoystickConfig_t config = {};
+  size_t config_size = sizeof(config);
+  CHECK(peripheral_query(0, JOY_QUERY_CONFIG, &config, &config_size) ==
+        peripheral_ok);
+  CHECK(config_size == sizeof(JoystickConfig_t));
+
+  KeyboardModifiers_t mods = {};
+  size_t mods_size = sizeof(mods);
+  CHECK(peripheral_query(0, keyboard_query_mods, &mods, &mods_size) ==
+        peripheral_ok);
+  CHECK(mods_size == sizeof(KeyboardModifiers_t));
+}
+
 // --- save states and repeating a run ---------------------------------------
 
 TEST_CASE("Agent: a save state puts the machine back where it was") {
