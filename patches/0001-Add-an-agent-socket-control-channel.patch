+TEST_CASE("Agent: disk_insert checks the drive and the path length") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+
+  CHECK(rejects("disk_insert", {{"drive", 0}}));  // no path
+  CHECK(rejects("disk_insert", {{"path", ""}, {"drive", 0}}));
+  CHECK(rejects("disk_insert", {{"path", "/tmp/a.dsk"}}));  // no drive
+  CHECK(rejects("disk_insert", {{"path", "/tmp/a.dsk"}, {"drive", 2}}));
+  CHECK(rejects("disk_insert", {{"path", "/tmp/a.dsk"}, {"drive", -1}}));
+
+  // The path is copied into a fixed buffer with its terminator, so a path of
+  // exactly the buffer size is one byte too long rather than a tight fit.
+  const std::string too_long(disk_insert_path_max, 'x');
+  const Json refused =
+      command("disk_insert", {{"path", too_long}, {"drive", 0}});
+  CHECK_FALSE(refused.at("ok").get<bool>());
+  CHECK(refused.at("error").get<std::string>() == "path too long");
+
+  // One byte shorter is a fit, and the dispatcher passes it to the drive. The
+  // drive takes any path it can copy, so the reply is ok even though no such
+  // file exists — what tells a client the disk is not in is `loaded`, not the
+  // status of the call.
+  const std::string longest(disk_insert_path_max - 1, 'x');
+  const Json accepted =
+      command("disk_insert", {{"path", longest}, {"drive", 0}});
+  CHECK(accepted.at("ok").get<bool>());
+  CHECK(accepted.at("result").at("drives").at(0).at("loaded").get<bool>() ==
+        false);
+
+  CHECK(rejects("disk_eject", Json::object()));
+  CHECK(rejects("disk_eject", {{"drive", 2}}));
+}
