+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <string>
+
+// Executes one JSON-line request and returns the JSON-line response body
+// without its trailing newline. Malformed input still produces a well-formed
+// error response so a client is never left waiting.
+auto agent_command_dispatch(const std::string& request_line) -> std::string;
diff --git a/src/frontends/common/agent/AgentInput.cpp b/src/frontends/common/agent/AgentInput.cpp
new file mode 100644
index 0000000..b303b29
--- /dev/null
+++ b/src/frontends/common/agent/AgentInput.cpp
@@ -0,0 +1,120 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "frontends/common/agent/AgentInput.h"
+
+#include <cstdint>
+#include <deque>
+#include <unordered_map>
+
+#include "apple2/CPU.h"
+#include "core/LinAppleCore.h"
+
+namespace {
+
+constexpr size_t default_limit = 4096;
+
+bool g_capturing = false;
+size_t g_limit = default_limit;
+uint64_t g_dropped = 0;
+std::deque<AgentInputEvent_t> g_events;
+// What each held key latched when it went down. A person can let shift go
+// before the key, and the release has to name the byte the press did or a
+// movie would hold down a key it never pressed.
+std::unordered_map<uint32_t, int> g_down_keys;
+
+auto push(const char* kind, int code, int value) -> void {
+  if (!g_capturing) {
+    return;
+  }
+  if (g_events.size() >= g_limit) {
+    // The newest input is the one a recorder still has a use for, and a
+    // silently short movie is worse than one that says how much it lost.
+    g_events.pop_front();
+    ++g_dropped;
+  }
+  g_events.push_back(
+      AgentInputEvent_t{cpu_get_cumulative_cycles(), kind, code, value});
+}
+
+constexpr int keyboard_slot = 0;
+
+// Asks the keyboard what this event puts on the machine's doorstep. That is
+// the only byte worth logging: it is what a client would have to send to press
+// the same key, shift, caps lock, layout and custom maps included. -1 means
+// nothing arrives, so there is nothing a replay could repeat.
+auto latched_key(const KeyboardEvent_t* event) -> int {
+  KeyboardTranslate_t request{};
+  request.event = *event;
+  size_t size = sizeof(request);
+  if (peripheral_query(keyboard_slot, keyboard_query_translate, &request,
+                       &size) != peripheral_ok) {
+    return -1;
+  }
+  if (request.latched == 0U || request.key == 0 || request.key > 0xFF) {
+    return -1;
+  }
+  return static_cast<int>(request.key);
+}
+
+}  // namespace
+
+auto agent_input_set_capture(bool on, size_t limit) -> void {
+  g_capturing = on;
+  g_limit = (limit > 0) ? limit : default_limit;
+  g_events.clear();
+  g_dropped = 0;
+  g_down_keys.clear();
+}
+
+auto agent_input_capturing() -> bool { return g_capturing; }
+
+auto agent_input_pending() -> size_t { return g_events.size(); }
+
+auto agent_input_dropped() -> uint64_t { return g_dropped; }
+
+auto agent_input_take(size_t max, AgentInputEvent_t* out) -> size_t {
+  size_t taken = 0;
+  while (taken < max && !g_events.empty()) {
+    out[taken] = g_events.front();
+    g_events.pop_front();
+    ++taken;
+  }
+  return taken;
+}
+
+auto agent_input_record_key(const KeyboardEvent_t* event) -> void {
+  if (!g_capturing || event == nullptr) {
+    return;
+  }
+  const bool down = event->is_down != 0U;
+  int code = -1;
+  if (down) {
+    code = latched_key(event);
+    if (code >= 0) {
+      g_down_keys[event->key] = code;
+    }
+  } else {
+    const auto held = g_down_keys.find(event->key);
+    if (held != g_down_keys.end()) {
+      code = held->second;
+      g_down_keys.erase(held);
+    } else {
+      // Released a key that went down before anyone was recording.
+      code = latched_key(event);
+    }
+  }
+  if (code < 0) {
+    // Function keys, modifiers and the rest of the frontend's own keys. They
+    // never reach the Apple II as keystrokes, so logging them would put
+    // something in a movie that replaying cannot reproduce.
+    return;
+  }
+  push("key", code, down ? 1 : 0);
+}
+
+auto agent_input_record_joy_axis(int axis, int value) -> void {
+  push("joy_axis", axis, value);
+}
+
+auto agent_input_record_joy_button(int button, bool down) -> void {
+  push("joy_button", button, down ? 1 : 0);
+}
diff --git a/src/frontends/common/agent/AgentInput.h b/src/frontends/common/agent/AgentInput.h
new file mode 100644
index 0000000..b2cad12
--- /dev/null
+++ b/src/frontends/common/agent/AgentInput.h
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include "apple2/peripherals/keyboard/KeyboardCommands.h"
+
+// A log of the input a person generated at the window.
+//
+// The agent socket sees only what a client sends. Someone playing in the SDL
+// window is talking to the frontend instead, so a recorder attached to the
+// socket would watch a game being played and record nothing at all. The
+// frontends hand every keystroke and stick movement here as well, stamped with
+// the cycle it happened on, and a client collects them with input_poll.
+//
+// Capture is off until a client asks for it: an idle session has no reason to
+// keep a buffer of keystrokes, and a session nobody is recording should cost
+// nothing at all.
+
+#ifdef LINAPPLE_AGENT
+
+struct AgentInputEvent_t {
+  uint64_t cycles;
+  // "key", "joy_axis" or "joy_button".
+  const char* kind;
+  // key code / axis number / button number.
+  int code;
+  // key and button: 1 for down. axis: the paddle position, 0..255.
+  int value;
+};
+
+auto agent_input_set_capture(bool on, size_t limit) -> void;
+auto agent_input_capturing() -> bool;
+auto agent_input_pending() -> size_t;
+// Events lost because the buffer filled between polls, since capture started.
+auto agent_input_dropped() -> uint64_t;
+
+// Takes up to `max` events off the front of the buffer.
+auto agent_input_take(size_t max, AgentInputEvent_t* out) -> size_t;
+
+// Called by the frontends, with the event exactly as it was handed to the
+// keyboard. What gets logged is the byte the keyboard says it will latch, not
+// the key the frontend named: a person holding shift types `"`, and a movie
+// that replayed the unshifted key would type `'` instead. The keyboard is
+// asked, because only it knows the layout, the custom maps and the caps lock.
+// A key that reaches the machine as nothing - a function key, a modifier, an
+// Apple key - is not logged at all, since a replay could not send it.
+auto agent_input_record_key(const KeyboardEvent_t* event) -> void;
+auto agent_input_record_joy_axis(int axis, int value) -> void;
+auto agent_input_record_joy_button(int button, bool down) -> void;
+
+#else
+
+// Without the agent module the frontends still call these, so they have to
+// exist and cost nothing.
+inline auto agent_input_record_key(const KeyboardEvent_t*) -> void {}
+inline auto agent_input_record_joy_axis(int, int) -> void {}
+inline auto agent_input_record_joy_button(int, bool) -> void {}
+
+#endif
diff --git a/src/frontends/common/agent/AgentServer.cpp b/src/frontends/common/agent/AgentServer.cpp
new file mode 100644
index 0000000..92d8cac
--- /dev/null
+++ b/src/frontends/common/agent/AgentServer.cpp
@@ -0,0 +1,297 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include "frontends/common/agent/AgentServer.h"
+
+#include <fcntl.h>
+#include <sys/poll.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/types.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstddef>
+#include <cstring>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "core/Log.h"
+#include "frontends/common/agent/AgentCommands.h"
+
+namespace {
+
+constexpr size_t read_chunk_size = 16384;
+constexpr size_t max_request_bytes = 4 * 1024 * 1024;
+constexpr int listen_backlog = 4;
+constexpr mode_t socket_permissions = 0600;
+
+struct AgentClient_t {
+  int fd = -1;
+  std::string inbox;
+  std::string outbox;
+  size_t sent = 0;
+};
+
+int g_listen_fd = -1;
+std::string g_socket_path;
+std::vector<AgentClient_t> g_clients;
+
+auto set_nonblocking(int fd) -> bool {
+  const int flags = fcntl(fd, F_GETFL, 0);
+  if (flags < 0) {
+    return false;
+  }
+  return fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0;
+}
+
+auto close_client(AgentClient_t& client) -> void {
+  if (client.fd >= 0) {
+    close(client.fd);
+    client.fd = -1;
+  }
+}
+
+// Drains as much of the pending response as the kernel will take. A large
+// screen_capture response easily exceeds the socket buffer, and a short write
+// on a non-blocking socket is normal rather than an error, so the remainder
+// stays queued for the next poll instead of being silently truncated.
+auto flush_outbox(AgentClient_t& client) -> bool {
+  while (client.sent < client.outbox.size()) {
+    const size_t remaining = client.outbox.size() - client.sent;
+    const ssize_t written = send(client.fd, client.outbox.data() + client.sent,
+                                 remaining, MSG_NOSIGNAL);
+    if (written > 0) {
+      client.sent += static_cast<size_t>(written);
+      continue;
+    }
+    if (written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+      return true;
+    }
+    if (written < 0 && errno == EINTR) {
+      continue;
+    }
+    return false;
+  }
+  client.outbox.clear();
+  client.sent = 0;
+  return true;
+}
+
+auto queue_response(AgentClient_t& client, const std::string& payload) -> void {
+  if (client.sent > 0 && client.sent == client.outbox.size()) {
+    client.outbox.clear();
+    client.sent = 0;
+  }
+  client.outbox.append(payload);
+  client.outbox.push_back('\n');
+}
+
+auto consume_lines(AgentClient_t& client) -> void {
+  size_t start = 0;
+  while (true) {
+    const size_t newline = client.inbox.find('\n', start);
+    if (newline == std::string::npos) {
+      break;
+    }
+    std::string line = client.inbox.substr(start, newline - start);
+    if (!line.empty() && line.back() == '\r') {
+      line.pop_back();
+    }
+    start = newline + 1;
+    if (line.empty()) {
+      continue;
+    }
+    queue_response(client, agent_command_dispatch(line));
+  }
+  if (start > 0) {
+    client.inbox.erase(0, start);
+  }
+  if (client.inbox.size() > max_request_bytes) {
+    Logger::warning("agent: request line exceeded %zu bytes, dropping client\n",
+                    max_request_bytes);
+    close_client(client);
+  }
+}
+
+auto read_client(AgentClient_t& client) -> void {
+  std::vector<char> chunk(read_chunk_size);
+  while (true) {
+    const ssize_t got = recv(client.fd, chunk.data(), chunk.size(), 0);
+    if (got > 0) {
+      client.inbox.append(chunk.data(), static_cast<size_t>(got));
+      if (static_cast<size_t>(got) < chunk.size()) {
+        break;
+      }
+      continue;
+    }
+    if (got == 0) {
+      close_client(client);
+      return;
+    }
+    if (errno == EINTR) {
+      continue;
+    }
+    if (errno != EAGAIN && errno != EWOULDBLOCK) {
+      close_client(client);
+      return;
+    }
+    break;
+  }
+  consume_lines(client);
+}
+
+auto accept_pending() -> void {
+  while (true) {
+    const int fd = accept(g_listen_fd, nullptr, nullptr);
+    if (fd < 0) {
+      return;
+    }
+    if (!set_nonblocking(fd)) {
+      close(fd);
+      continue;
+    }
+    AgentClient_t client;
+    client.fd = fd;
+    g_clients.push_back(std::move(client));
+    Logger::info("agent: client connected (%zu active)\n", g_clients.size());
+  }
+}
+
+auto reap_closed_clients() -> void {
+  for (size_t i = g_clients.size(); i > 0; --i) {
+    if (g_clients.at(i - 1).fd < 0) {
+      g_clients.erase(g_clients.begin() + static_cast<ptrdiff_t>(i - 1));
+    }
+  }
+}
+
+}  // namespace
+
+auto agent_server_start(const char* socket_path) -> int {
+  if (socket_path == nullptr || socket_path[0] == '\0') {
+    return -1;
+  }
+  if (g_listen_fd >= 0) {
+    return 0;
+  }
+
+  sockaddr_un addr = {};
+  addr.sun_family = AF_UNIX;
+  const size_t path_len = std::strlen(socket_path);
+  if (path_len >= sizeof(addr.sun_path)) {
+    Logger::error("agent: socket path too long (%zu bytes)\n", path_len);
+    return -1;
+  }
+  std::memcpy(static_cast<void*>(addr.sun_path), socket_path, path_len + 1);
+
+  const int fd = socket(AF_UNIX, SOCK_STREAM, 0);
+  if (fd < 0) {
+    Logger::error("agent: socket() failed: %s\n", std::strerror(errno));
+    return -1;
+  }
+
+  // A socket file left behind by a crashed session would make bind() fail, and
+  // the path is caller-supplied rather than probed, so removing it is safe.
+  unlink(socket_path);
+
+  if (bind(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0) {
+    Logger::error("agent: bind(%s) failed: %s\n", socket_path,
+                  std::strerror(errno));
+    close(fd);
+    return -1;
+  }
+  if (chmod(socket_path, socket_permissions) != 0) {
+    Logger::warning("agent: chmod(%s) failed: %s\n", socket_path,
+                    std::strerror(errno));
+  }
+  if (listen(fd, listen_backlog) != 0) {
+    Logger::error("agent: listen() failed: %s\n", std::strerror(errno));
+    close(fd);
+    unlink(socket_path);
+    return -1;
+  }
+  if (!set_nonblocking(fd)) {
+    Logger::error("agent: fcntl(O_NONBLOCK) failed: %s\n",
+                  std::strerror(errno));
+    close(fd);
+    unlink(socket_path);
+    return -1;
+  }
+
+  g_listen_fd = fd;
+  g_socket_path = socket_path;
+  Logger::info("agent: listening on %s\n", socket_path);
+  return 0;
+}
+
+auto agent_server_poll(int timeout_ms) -> void {
+  if (g_listen_fd < 0) {
+    return;
+  }
+
+  std::vector<pollfd> fds;
+  fds.reserve(g_clients.size() + 1);
+  fds.push_back({g_listen_fd, POLLIN, 0});
+  for (const AgentClient_t& client : g_clients) {
+    short events = POLLIN;
+    if (client.sent < client.outbox.size()) {
+      events |= POLLOUT;
+    }
+    fds.push_back({client.fd, events, 0});
+  }
+
+  if (poll(fds.data(), static_cast<nfds_t>(fds.size()), timeout_ms) <= 0) {
+    return;
+  }
+
+  if ((fds.front().revents & POLLIN) != 0) {
+    accept_pending();
+  }
+
+  for (size_t i = 0; i < g_clients.size() && (i + 1) < fds.size(); ++i) {
+    AgentClient_t& client = g_clients.at(i);
+    const short revents = fds.at(i + 1).revents;
+    if (client.fd < 0) {
+      continue;
+    }
+    if ((revents & (POLLHUP | POLLERR | POLLNVAL)) != 0) {
+      close_client(client);
+      continue;
+    }
+    if ((revents & POLLOUT) != 0 && !flush_outbox(client)) {
+      close_client(client);
+      continue;
+    }
+    if ((revents & POLLIN) != 0) {
+      read_client(client);
+    }
+    if (client.fd >= 0 && !flush_outbox(client)) {
+      close_client(client);
+    }
+  }
+
+  reap_closed_clients();
+}
+
+auto agent_server_stop() -> void {
+  for (AgentClient_t& client : g_clients) {
+    close_client(client);
+  }
+  g_clients.clear();
+
+  if (g_listen_fd >= 0) {
+    close(g_listen_fd);
+    g_listen_fd = -1;
+  }
+  if (!g_socket_path.empty()) {
+    unlink(g_socket_path.c_str());
+    g_socket_path.clear();
+  }
+}
+
+auto agent_server_is_active() -> bool { return g_listen_fd >= 0; }
+
+auto agent_server_client_count() -> int {
+  return static_cast<int>(g_clients.size());
+}
