+// The agent socket's way to put a stick somewhere. Axes are numbered the way
+// the paddle registers are: 0 and 1 are the first stick's x and y, 2 and 3
+// the second stick's. The value is a position, clamped to the port's range.
+auto linapple_set_joystick_axis(int axis, int value) -> void {
+  if (axis < 0 || axis > 3) {
+    return;
+  }
+  const int position = (value < 0) ? 0 : ((value > 255) ? 255 : value);
+  const JoystickAxisPayload payload = {static_cast<uint8_t>(axis >> 1),
+                                       static_cast<uint8_t>(axis & 1),
+                                       static_cast<uint8_t>(position), 0};
+  peripheral_command(0, JOYSTICK_CMD_SET_AXIS, &payload, sizeof(payload));
+}
+
 auto linapple_set_game_switch(uint8_t line, bool down) -> void {
   switch_inputs_set_level(line, switch_source_connector, down);
 }
