diff --git a/tests/test_agent_commands.cpp b/tests/test_agent_commands.cpp
new file mode 100644
index 0000000..321b681
--- /dev/null
+++ b/tests/test_agent_commands.cpp
@@ -0,0 +1,1000 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// Agent control-channel tests.
+//
+// The dispatcher is the surface an external tool sees, so what matters here is
+// the contract it promises that client: a well-formed response for every input,
+// a refusal rather than a wild read for an out-of-range parameter, a screen
+// hash that follows whichever page the machine is actually displaying, and a
+// wait that ends for each of its three reasons. The server cases cover the
+// framing around that contract — line splitting and the request size cap.
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "HeadlessHarness.h"
+#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
+#include <nlohmann/json.hpp>
+
+#include "apple2/CPU.h"
+#include "apple2/Memory.h"
+#include "apple2/Video.h"
+#include "apple2/peripherals/disk/DiskCommands.h"
+#include "apple2/peripherals/joystick/JoystickCommands.h"
+#include "apple2/peripherals/keyboard/KeyboardCommands.h"
+#include "core/LinAppleCore.h"
+#include "core/Peripheral.h"
+#include "doctest.h"
+#include "frontends/common/agent/AgentCommands.h"
+#include "frontends/common/agent/AgentInput.h"
+#include "frontends/common/agent/AgentServer.h"
+
+namespace {
+
+using Json = nlohmann::json;
+
+// Whether a frontend can record at all is the frontend's business; what the
+// command has to get right is refusing a request it cannot honour and saying
+// afterwards what is actually being written. A fake recorder is enough to test
+// that, and it stands in for the real one the way a headless build has none.
+std::string g_fake_dump_path;
+
+}  // namespace
+
+auto frontend_audio_dump_start(const char* path) -> bool {
+  if (path == nullptr || std::string(path) == "/nowhere/at/all.wav") {
+    return false;  // the frontend cannot write there
+  }
+  g_fake_dump_path = path;
+  return true;
+}
+
+auto frontend_audio_dump_stop() -> void { g_fake_dump_path.clear(); }
+
+auto frontend_audio_dump_path() -> const char* {
+  return g_fake_dump_path.c_str();
+}
+
+namespace {
+
+// Every response is a JSON object on one line, including the error paths — a
+// client that cannot parse a reply has no way to tell a refusal from a hang.
+auto dispatch_line(const std::string& line) -> Json {
+  const std::string reply = agent_command_dispatch(line);
+  CHECK(reply.find('\n') == std::string::npos);
+  Json parsed = Json::parse(reply, nullptr, false);
+  REQUIRE_FALSE(parsed.is_discarded());
+  REQUIRE(parsed.is_object());
+  REQUIRE(parsed.contains("ok"));
+  return parsed;
+}
+
+// What a frontend hands the keyboard when a person presses a key. The mods
+// travel with the event, which is how the keyboard knows a held shift turns
+// `p` into `P`.
+auto key_event(uint32_t key, bool down, bool shift = false, bool ctrl = false)
+    -> KeyboardEvent_t {
+  return KeyboardEvent_t{key,
+                         static_cast<uint8_t>(down ? 1 : 0),
+                         static_cast<uint8_t>(shift ? 1 : 0),
+                         static_cast<uint8_t>(ctrl ? 1 : 0),
+                         0,
+                         0,
+                         {0, 0, 0}};
+}
+
+auto record_key(uint32_t key, bool down, bool shift = false, bool ctrl = false)
+    -> void {
+  const KeyboardEvent_t event = key_event(key, down, shift, ctrl);
+  agent_input_record_key(&event);
+}
+
+auto command(const char* cmd, const Json& params = Json::object()) -> Json {
+  Json request;
+  request["cmd"] = cmd;
+  request["params"] = params;
+  return dispatch_line(request.dump());
+}
+
+auto ok_result(const char* cmd, const Json& params = Json::object()) -> Json {
+  const Json response = command(cmd, params);
+  REQUIRE_MESSAGE(response.at("ok").get<bool>() == true, response.dump());
+  return response.at("result");
+}
+
+auto rejects(const char* cmd, const Json& params) -> bool {
+  const Json response = command(cmd, params);
+  if (response.at("ok").get<bool>()) {
+    return false;
+  }
+  // An error carries a message rather than a result, so a client can log
+  // something useful instead of "the call failed".
+  return response.contains("error") && response.at("error").is_string() &&
+         !response.at("error").get<std::string>().empty() &&
+         !response.contains("result");
+}
+
+// The soft switches have no setter of their own: the machine flips them by
+// touching $C05x, and the tests drive them the same way the CPU would.
+auto touch_switch(uint16_t address) -> void {
+  video_set_mode(0, address, 0, 0, 0);
+}
+
+auto select_text_page1() -> void {
+  touch_switch(0xC000);  // 80STORE off, so PAGE2 means the display page
+  touch_switch(0xC00C);  // 40 columns
+  touch_switch(0xC054);  // page 1
+  touch_switch(0xC052);  // not mixed
+  touch_switch(0xC051);  // text
+}
+
+auto poke(uint16_t address, uint8_t value) -> void {
+  uint8_t* cell = mem_get_main_ptr(address);
+  REQUIRE(cell != nullptr);
+  *cell = value;
+}
+
+// The joystick has no query of its own, so its save state is how a test sees
+// where the sticks actually are. Input commands are queued rather than applied
+// on the spot - they land when the machine next runs - so the queue is drained
+// first, which is what the next run_frames would have done.
+auto joystick_state_raw() -> JoystickSaveState_t {
+  JoystickSaveState_t state = {};
+  size_t size = sizeof(state);
+  peripheral_save_state_by_name(0, "Joystick", &state, &size);
+  REQUIRE(size == sizeof(state));
+  return state;
+}
+
+auto joystick_state() -> JoystickSaveState_t {
+  peripheral_manager_think(0);
+  return joystick_state_raw();
+}
+
+auto screen_hash() -> uint64_t {
+  return ok_result("screen_hash").at("hash").get<uint64_t>();
+}
+
+// Parks the CPU on a program of our own so the screen changes exactly when the
+// test says it does. Left to the boot ROM the machine would be hunting for a
+// disk, and a wait that has to settle would be racing the drive.
+auto run_program(uint16_t address, const std::vector<uint8_t>& code) -> void {
+  for (size_t i = 0; i < code.size(); ++i) {
+    poke(static_cast<uint16_t>(address + i), code.at(i));
+  }
+  CpuRegisters_t* regs = cpu_get_registers();
+  REQUIRE(regs != nullptr);
+  regs->pc = address;
+  regs->is_jammed = 0;
+}
+
+// JMP to itself: the machine stays alive and the screen never moves.
+const std::vector<uint8_t> program_idle = {0x4C, 0x00, 0x03};
+
+// Writes one character to the top-left cell, then idles. One change, then
+// quiet — what a game redrawing a screen and waiting for input looks like.
+const std::vector<uint8_t> program_draw_once = {
+    0xA9, 0xC1,        // LDA #$C1
+    0x8D, 0x00, 0x04,  // STA $0400
+    0x4C, 0x05, 0x03   // JMP $0305
+};
+
+// Copies the keyboard latch to the top-left cell, forever. What the running
+// program can see of an input, as opposed to what the peripheral holds.
+const std::vector<uint8_t> program_watch_keyboard = {
+    0xAD, 0x00, 0xC0,  // LDA $C000
+    0x8D, 0x00, 0x04,  // STA $0400
+    0x4C, 0x00, 0x03   // JMP $0300
+};
+
+// Never stops repainting, which is the case a wait must not sit out forever.
+const std::vector<uint8_t> program_draw_forever = {
+    0xEE, 0x00, 0x04,  // INC $0400
+    0x4C, 0x00, 0x03   // JMP $0300
+};
+
+auto wait_params(int64_t max_frames, int64_t chunk) -> Json {
+  Json params;
+  params["max_frames"] = max_frames;
+  params["chunk"] = chunk;
+  params["stable"] = 2;
+  // Full duty: the rest between chunks exists to keep a long wait from cooking
+  // a core, and a test has no reason to pay for it.
+  params["duty"] = 100;
+  return params;
+}
+
+// --- socket helpers --------------------------------------------------------
+
+struct AgentSocketFixture_t {
+  std::string directory;
+  std::string path;
+  int fd = -1;
+
+  AgentSocketFixture_t() {
+    std::vector<char> pattern(64);
+    const char* tmpdir = getenv("TMPDIR");
+    const std::string base =
+        (tmpdir != nullptr && tmpdir[0] != '\0') ? tmpdir : "/tmp";
+    const std::string tpl = base + "/linapple-agent-XXXXXX";
+    pattern.assign(tpl.begin(), tpl.end());
+    pattern.push_back('\0');
+    REQUIRE(mkdtemp(pattern.data()) != nullptr);
+    directory = pattern.data();
+    path = directory + "/agent.sock";
+  }
+
+  ~AgentSocketFixture_t() {
+    disconnect();
+    agent_server_stop();
+    unlink(path.c_str());
+    rmdir(directory.c_str());
+  }
+
+  AgentSocketFixture_t(const AgentSocketFixture_t&) = delete;
+  auto operator=(const AgentSocketFixture_t&) -> AgentSocketFixture_t& = delete;
+  AgentSocketFixture_t(AgentSocketFixture_t&&) = delete;
+  auto operator=(AgentSocketFixture_t&&) -> AgentSocketFixture_t& = delete;
+
+  auto start() -> void {
+    REQUIRE(agent_server_start(path.c_str()) == 0);
+    REQUIRE(agent_server_is_active());
+  }
+
+  auto connect_client() -> void {
+    fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    REQUIRE(fd >= 0);
+    sockaddr_un addr = {};
+    addr.sun_family = AF_UNIX;
+    std::memcpy(static_cast<void*>(addr.sun_path), path.c_str(),
+                path.size() + 1);
+    REQUIRE(connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) == 0);
+    // Non-blocking on this side too: the server drains only when the test
+    // pumps it, so a blocking write of a large request would deadlock against
+    // a test that is waiting to make that very call.
+    const int flags = fcntl(fd, F_GETFL, 0);
+    REQUIRE(fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0);
+    agent_server_poll(0);
+    REQUIRE(agent_server_client_count() == 1);
+  }
+
+  auto disconnect() -> void {
+    if (fd >= 0) {
+      close(fd);
+      fd = -1;
+    }
+  }
+
+  auto send_raw(const std::string& payload) -> void {
+    size_t sent = 0;
+    while (sent < payload.size()) {
+      const ssize_t written =
+          send(fd, payload.data() + sent, payload.size() - sent, MSG_NOSIGNAL);
+      if (written > 0) {
+        sent += static_cast<size_t>(written);
+        continue;
+      }
+      if (written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+        agent_server_poll(0);
+        continue;
+      }
+      FAIL("send to agent socket failed");
+      return;
+    }
+  }
+
+  // Pumps both sides until the requested number of newline-terminated replies
+  // has arrived, or the budget runs out. A bounded loop rather than a blocking
+  // read keeps a regression from turning into a hung test run.
+  auto collect_replies(size_t count) -> std::vector<std::string> {
+    std::string inbox;
+    std::vector<std::string> lines;
+    for (int attempt = 0; attempt < 200 && lines.size() < count; ++attempt) {
+      agent_server_poll(1);
+      std::vector<char> chunk(4096);
+      const ssize_t got = recv(fd, chunk.data(), chunk.size(), 0);
+      if (got > 0) {
+        inbox.append(chunk.data(), static_cast<size_t>(got));
+      }
+      size_t start = 0;
+      lines.clear();
+      while (true) {
+        const size_t newline = inbox.find('\n', start);
+        if (newline == std::string::npos) {
+          break;
+        }
+        lines.push_back(inbox.substr(start, newline - start));
+        start = newline + 1;
+      }
+    }
+    return lines;
+  }
+};
+
+}  // namespace
+
+// --- malformed input -------------------------------------------------------
+
+TEST_CASE("Agent: unusable input still answers with ok:false") {
+  // No harness: none of these reach the machine, and a reply is owed even when
+  // the request never named a command.
+  const char* const unusable[] = {
+      "",
+      "not json at all",
+      "{",
+      "[1, 2, 3]",           // valid JSON, but not a request object
+      "\"ping\"",            // ditto
+      "null",                //
+      "{}",                  // no cmd
+      "{\"cmd\": 42}",       // cmd of the wrong type
+      "{\"params\": {}}",    // params without a cmd
+      "{\"cmd\": \"nope\"}"  // a command that does not exist
+  };
+  for (const char* line : unusable) {
+    const Json response = dispatch_line(line);
+    CHECK_FALSE(response.at("ok").get<bool>());
+    CHECK(response.contains("error"));
+    CHECK(response.at("error").is_string());
+    // id is always present, so a client can match a reply to its request even
+    // when the request was too broken to carry one.
+    CHECK(response.contains("id"));
+  }
+}
+
+TEST_CASE("Agent: the request id comes back on both paths") {
+  const Json accepted = dispatch_line("{\"cmd\": \"ping\", \"id\": 17}");
+  CHECK(accepted.at("ok").get<bool>());
+  CHECK(accepted.at("id").get<int>() == 17);
+
+  const Json refused = dispatch_line("{\"cmd\": \"nope\", \"id\": \"abc\"}");
+  CHECK_FALSE(refused.at("ok").get<bool>());
+  CHECK(refused.at("id").get<std::string>() == "abc");
+
+  const Json anonymous = dispatch_line("{\"cmd\": \"ping\"}");
+  CHECK(anonymous.at("id").is_null());
+}
+
+// --- parameter ranges ------------------------------------------------------
+
+TEST_CASE("Agent: mem_read refuses addresses outside the address space") {
+  HeadlessHarness_t harness;
+
+  CHECK(rejects("mem_read", {{"addr", -1}}));
+  CHECK(rejects("mem_read", {{"addr", 0x10000}}));
+  CHECK(rejects("mem_read", Json::object()));  // addr defaults to -1
+  CHECK(
+      rejects("mem_read", {{"addr", "0x300"}}));  // wrong type, same as absent
+  CHECK(rejects("mem_read", {{"addr", 0x300}, {"len", 0}}));
+  CHECK(rejects("mem_read", {{"addr", 0x300}, {"len", -4}}));
+  CHECK(rejects("mem_read", {{"addr", 0x300}, {"len", 0x10001}}));
+  // In range on its own, but the read would run off the end of memory.
+  CHECK(rejects("mem_read", {{"addr", 0xFFFF}, {"len", 2}}));
+
+  // The edges that should be allowed still are.
+  CHECK(ok_result("mem_read", {{"addr", 0xFFFF}, {"len", 1}}).at("len") == 1);
+  CHECK(ok_result("mem_read", {{"addr", 0}, {"len", 0x10000}}).at("len") ==
+        0x10000);
+}
+
+TEST_CASE("Agent: mem_read returns what memory holds") {
+  HeadlessHarness_t harness;
+
+  poke(0x6000, 0xDE);
+  poke(0x6001, 0xAD);
+  poke(0x6002, 0xBE);
+  poke(0x6003, 0xEF);
+
+  const Json result = ok_result("mem_read", {{"addr", 0x6000}, {"len", 4}});
+  CHECK(result.at("addr").get<int>() == 0x6000);
+  CHECK(result.at("len").get<int>() == 4);
+  CHECK(result.at("data").get<std::string>() == "3q2+7w==");
+}
+
+TEST_CASE("Agent: mem_write refuses a payload it cannot place") {
+  HeadlessHarness_t harness;
+
+  CHECK(rejects("mem_write", {{"addr", -1}, {"bytes", {1}}}));
+  CHECK(rejects("mem_write", {{"addr", 0x10000}, {"bytes", {1}}}));
+  CHECK(rejects("mem_write", {{"addr", 0x300}}));  // neither data nor bytes
+  CHECK(rejects("mem_write", {{"addr", 0x300}, {"bytes", Json::array()}}));
+  CHECK(rejects("mem_write", {{"addr", 0x300}, {"bytes", {"nope"}}}));
+  CHECK(rejects("mem_write", {{"addr", 0x300}, {"data", "not base64!"}}));
+  // One byte past the end of memory.
+  CHECK(rejects("mem_write", {{"addr", 0xFFFF}, {"bytes", {1, 2}}}));
+
+  const Json written =
+      ok_result("mem_write", {{"addr", 0x6000}, {"data", "3q2+7w=="}});
+  CHECK(written.at("written").get<int>() == 4);
+  CHECK(ok_result("mem_read", {{"addr", 0x6000}, {"len", 4}})
+            .at("data")
+            .get<std::string>() == "3q2+7w==");
+}
+
+TEST_CASE("Agent: disk_insert checks the drive and the path length") {
+  HeadlessHarness_t harness;
+
+  CHECK(rejects("disk_insert", {{"drive", 0}}));  // no path
+  CHECK(rejects("disk_insert", {{"path", ""}, {"drive", 0}}));
+  CHECK(rejects("disk_insert", {{"path", "/tmp/a.dsk"}}));  // no drive
+  CHECK(rejects("disk_insert", {{"path", "/tmp/a.dsk"}, {"drive", 2}}));
+  CHECK(rejects("disk_insert", {{"path", "/tmp/a.dsk"}, {"drive", -1}}));
+
+  // The path is copied into a fixed buffer with its terminator, so a path of
+  // exactly the buffer size is one byte too long rather than a tight fit.
+  const std::string too_long(disk_insert_path_max, 'x');
+  const Json refused =
+      command("disk_insert", {{"path", too_long}, {"drive", 0}});
+  CHECK_FALSE(refused.at("ok").get<bool>());
+  CHECK(refused.at("error").get<std::string>() == "path too long");
+
+  // One byte shorter is a fit, and the dispatcher passes it to the drive. The
+  // drive takes any path it can copy, so the reply is ok even though no such
+  // file exists — what tells a client the disk is not in is `loaded`, not the
+  // status of the call.
+  const std::string longest(disk_insert_path_max - 1, 'x');
+  const Json accepted =
+      command("disk_insert", {{"path", longest}, {"drive", 0}});
+  CHECK(accepted.at("ok").get<bool>());
+  CHECK(accepted.at("result").at("drives").at(0).at("loaded").get<bool>() ==
+        false);
+
+  CHECK(rejects("disk_eject", Json::object()));
+  CHECK(rejects("disk_eject", {{"drive", 2}}));
+}
+
+TEST_CASE("Agent: the remaining bounded parameters refuse their edges") {
+  HeadlessHarness_t harness;
+
+  CHECK(rejects("key_press", {{"key", -1}}));
+  CHECK(rejects("key_press", {{"key", 256}}));
+  CHECK(rejects("key_press", Json::object()));
+  CHECK(rejects("key_state", {{"key", 256}}));
+  CHECK(rejects("key_type", Json::object()));  // empty text is not a keystroke
+
+  CHECK(rejects("joy_axis", {{"axis", -1}}));
+  CHECK(rejects("joy_axis", {{"axis", 4}}));
+  CHECK(rejects("joy_button", {{"button", 3}}));
+
+  CHECK(rejects("run_frames", {{"frames", -1}}));
+  CHECK(rejects("run_frames", {{"frames", 60 * 60 * 10 + 1}}));
+
+  CHECK(rejects("speed_set", {{"speed", SPEED_MIN - 1}}));
+  CHECK(rejects("speed_set", {{"speed", emulation_speed_max + 1}}));
+  CHECK(ok_result("speed_set", {{"speed", SPEED_NORMAL}}).at("speed") ==
+        SPEED_NORMAL);
+}
+
+// --- joystick --------------------------------------------------------------
+
+TEST_CASE("Agent: joy_axis puts each stick where it was told") {
+  HeadlessHarness_t harness;
+
+  const JoystickSaveState_t rest = joystick_state();
+  CHECK(rest.x_pos[0] == 127);
+  CHECK(rest.y_pos[1] == 127);
+
+  ok_result("joy_axis", {{"axis", 0}, {"value", 0}});
+  ok_result("joy_axis", {{"axis", 1}, {"value", 255}});
+  ok_result("joy_axis", {{"axis", 2}, {"value", 40}});
+  ok_result("joy_axis", {{"axis", 3}, {"value", 200}});
+
+  const JoystickSaveState_t moved = joystick_state();
+  CHECK(moved.x_pos[0] == 0);
+  CHECK(moved.y_pos[0] == 255);
+  // The second stick is its own. Driving trim instead of position folded these
+  // two onto the first stick's axes, and both sticks moved together.
+  CHECK(moved.x_pos[1] == 40);
+  CHECK(moved.y_pos[1] == 200);
+
+  // Trim is the user's calibration, and no amount of stick movement touches it.
+  CHECK(moved.trim_x == 0);
+  CHECK(moved.trim_y == 0);
+}
+
+TEST_CASE("Agent: joy_axis takes a position, not a nudge") {
+  HeadlessHarness_t harness;
+
+  CHECK(rejects("joy_axis", {{"axis", 0}}));  // a missing value is not centre
+  CHECK(rejects("joy_axis", {{"axis", 0}, {"value", -1}}));
+  CHECK(rejects("joy_axis", {{"axis", 0}, {"value", 256}}));
+  CHECK(rejects("joy_axis", {{"axis", 4}, {"value", 127}}));
+
