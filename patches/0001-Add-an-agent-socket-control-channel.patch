+  CHECK(events.at(2).at("value").get<int>() == 200);
+  CHECK(events.at(3).at("kind").get<std::string>() == "joy_button");
+  CHECK(events.at(3).at("code").get<int>() == 1);
+
+  // Polling takes them off, so the next poll is empty rather than a repeat.
+  CHECK(ok_result("input_poll").at("events").empty());
+  agent_input_set_capture(false, 0);
+}
