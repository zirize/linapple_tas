+TEST_CASE("Agent: the input log stamps the cycle it happened on") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  select_text_page1();
+  run_program(0x0300, program_idle);
+  ok_result("input_capture", {{"on", true}});
+
+  record_key(0x41, true);
+  ok_result("run_frames", {{"frames", 10}});
+  record_key(0x41, false);
+
+  const Json events = ok_result("input_poll").at("events");
+  REQUIRE(events.size() == 2);
+  const auto first = events.at(0).at("cycles").get<uint64_t>();
+  const auto second = events.at(1).at("cycles").get<uint64_t>();
+  CHECK(second > first);
+  // Ten frames of cycles passed between them, which is how a recorder turns a
+  // cycle stamp back into a frame number.
+  CHECK((second - first) > 10 * 17000);
+  agent_input_set_capture(false, 0);
+}
