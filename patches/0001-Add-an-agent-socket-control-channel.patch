+TEST_CASE("Agent: unusable input still answers with ok:false") {
+  // No harness: none of these reach the machine, and a reply is owed even when
+  // the request never named a command.
+  const char* const unusable[] = {
+      "",
+      "not json at all",
+      "{",
+      "[1, 2, 3]",           // valid JSON, but not a request object
+      "\"ping\"",            // ditto
+      "null",                //
+      "{}",                  // no cmd
+      "{\"cmd\": 42}",       // cmd of the wrong type
+      "{\"params\": {}}",    // params without a cmd
+      "{\"cmd\": \"nope\"}"  // a command that does not exist
+  };
+  for (const char* line : unusable) {
+    const Json response = dispatch_line(line);
+    CHECK_FALSE(response.at("ok").get<bool>());
+    CHECK(response.contains("error"));
+    CHECK(response.at("error").is_string());
+    // id is always present, so a client can match a reply to its request even
+    // when the request was too broken to carry one.
+    CHECK(response.contains("id"));
+  }
+}
