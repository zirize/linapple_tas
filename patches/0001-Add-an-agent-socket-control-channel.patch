+/** What a key event would turn into, without pressing anything.
+ *
+ * The caller fills in `event` exactly as it would send it and reads back the
+ * byte the machine would latch. Only the keyboard can answer this: the layout,
+ * the custom maps and the caps-lock state all live here, which is why a
+ * frontend that wants to log what a person typed has to ask rather than work
+ * it out for itself.
+ */
+typedef struct {
+  KeyboardEvent_t event; /**< in: the event as it would be sent */
+  uint32_t key;          /**< out: the byte the keyboard would latch */
+  uint8_t latched; /**< out: 0 when the key reaches the machine as nothing */
+  uint8_t reserved[3]; /**< Padding for 8-byte ABI alignment */
+} KeyboardTranslate_t;
+
