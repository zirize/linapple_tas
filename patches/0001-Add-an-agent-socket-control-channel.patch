+TEST_CASE("Agent: audio_dump starts, reports and stops") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+
+  // Nothing is being recorded until someone asks.
+  Json result = ok_result("audio_dump", {{"on", false}});
+  CHECK(result.at("dumping").get<bool>() == false);
+  CHECK(result.at("path").get<std::string>().empty());
+
+  // A recording needs somewhere to go.
+  CHECK(rejects("audio_dump", {{"on", true}}));
+
+  result = ok_result("audio_dump", {{"on", true}, {"path", "/tmp/sound.wav"}});
+  CHECK(result.at("dumping").get<bool>() == true);
+  CHECK(result.at("path").get<std::string>() == "/tmp/sound.wav");
+
+  // A frontend that cannot record has to say so rather than let the caller
+  // believe a file is being written.
+  CHECK(rejects("audio_dump", {{"on", true}, {"path", "/nowhere/at/all.wav"}}));
+
+  result = ok_result("audio_dump", {{"on", false}});
+  CHECK(result.at("dumping").get<bool>() == false);
+}
