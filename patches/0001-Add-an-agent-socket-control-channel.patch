+// SPDX-License-Identifier: GPL-2.0-only
+//
+// Agent control-channel tests.
+//
+// The dispatcher is the surface an external tool sees, so what matters here is
+// the contract it promises that client: a well-formed response for every input,
+// a refusal rather than a wild read for an out-of-range parameter, a screen
+// hash that follows whichever page the machine is actually displaying, and a
+// wait that ends for each of its three reasons. The server cases cover the
+// framing around that contract — line splitting and the request size cap.
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "HeadlessHarness.h"
+#define DOCTEST_CONFIG_IMPLEMENT_WITH_MAIN
+#include <nlohmann/json.hpp>
+
+#include "apple2/CPU.h"
+#include "apple2/Memory.h"
+#include "apple2/SwitchInputs.h"
+#include "apple2/Video.h"
+#include "apple2/peripherals/disk/DiskCommands.h"
+#include "apple2/peripherals/joystick/JoystickCommands.h"
+#include "apple2/peripherals/keyboard/KeyboardCommands.h"
+#include "core/LinAppleCore.h"
+#include "frontends/common/KeyboardTranslator.h"
+#include "apple2/peripherals/Peripheral.h"
+#include "doctest.h"
+#include "test_fixtures.h"
+#include "frontends/common/agent/AgentCommands.h"
+#include "frontends/common/agent/AgentInput.h"
+#include "frontends/common/agent/AgentServer.h"
+
+namespace {
+
+using Json = nlohmann::json;
+// The harness takes the machine it should come up as; a Disk II in slot 6
+// is what the disk commands need and costs the other cases nothing.
+using TestConfig = TestFixtures::ScopedTestConfig;
+
+// Whether a frontend can record at all is the frontend's business; what the
+// command has to get right is refusing a request it cannot honour and saying
+// afterwards what is actually being written. A fake recorder is enough to test
+// that, and it stands in for the real one the way a headless build has none.
+std::string g_fake_dump_path;
+
+}  // namespace
+
+auto frontend_audio_dump_start(const char* path) -> bool {
+  if (path == nullptr || std::string(path) == "/nowhere/at/all.wav") {
+    return false;  // the frontend cannot write there
+  }
+  g_fake_dump_path = path;
+  return true;
+}
+
+auto frontend_audio_dump_stop() -> void { g_fake_dump_path.clear(); }
+
+auto frontend_audio_dump_path() -> const char* {
+  return g_fake_dump_path.c_str();
+}
+
+namespace {
+
+// Every response is a JSON object on one line, including the error paths — a
+// client that cannot parse a reply has no way to tell a refusal from a hang.
+auto dispatch_line(const std::string& line) -> Json {
+  const std::string reply = agent_command_dispatch(line);
+  CHECK(reply.find('\n') == std::string::npos);
+  Json parsed = Json::parse(reply, nullptr, false);
+  REQUIRE_FALSE(parsed.is_discarded());
+  REQUIRE(parsed.is_object());
+  REQUIRE(parsed.contains("ok"));
+  return parsed;
+}
+
+// What a frontend does when a person presses a key: the host translates it,
+// and only a key with an Apple meaning reaches the card - and the recorder.
+// The mods travel with the key, which is how a held shift turns `p` into `P`.
+auto record_key(uint32_t key, bool down, bool shift = false, bool ctrl = false)
+    -> void {
+  const KeyboardHostKey host_key = {0, key, shift, ctrl};
+  uint8_t apple_code = 0;
+  if (!keyboard_translate(&host_key, &apple_code)) {
+    return;
+  }
+  agent_input_record_key(key, apple_code, down);
+}
+
+auto command(const char* cmd, const Json& params = Json::object()) -> Json {
+  Json request;
+  request["cmd"] = cmd;
+  request["params"] = params;
+  return dispatch_line(request.dump());
+}
+
+auto ok_result(const char* cmd, const Json& params = Json::object()) -> Json {
+  const Json response = command(cmd, params);
+  REQUIRE_MESSAGE(response.at("ok").get<bool>() == true, response.dump());
+  return response.at("result");
+}
+
+auto rejects(const char* cmd, const Json& params) -> bool {
+  const Json response = command(cmd, params);
+  if (response.at("ok").get<bool>()) {
+    return false;
+  }
+  // An error carries a message rather than a result, so a client can log
+  // something useful instead of "the call failed".
+  return response.contains("error") && response.at("error").is_string() &&
+         !response.at("error").get<std::string>().empty() &&
+         !response.contains("result");
+}
+
+// The soft switches have no setter of their own: the machine flips them by
+// touching $C05x, and the tests drive them the same way the CPU would.
+auto touch_switch(uint16_t address) -> void {
+  video_set_mode(0, address, 0, 0, 0);
+}
+
+auto select_text_page1() -> void {
+  touch_switch(0xC000);  // 80STORE off, so PAGE2 means the display page
+  touch_switch(0xC00C);  // 40 columns
+  touch_switch(0xC054);  // page 1
+  touch_switch(0xC052);  // not mixed
+  touch_switch(0xC051);  // text
+}
+
+auto poke(uint16_t address, uint8_t value) -> void {
+  uint8_t* cell = mem_get_main_ptr(address);
+  REQUIRE(cell != nullptr);
+  *cell = value;
+}
+
+auto screen_hash() -> uint64_t {
+  return ok_result("screen_hash").at("hash").get<uint64_t>();
+}
+
+// Parks the CPU on a program of our own so the screen changes exactly when the
+// test says it does. Left to the boot ROM the machine would be hunting for a
+// disk, and a wait that has to settle would be racing the drive.
+auto run_program(uint16_t address, const std::vector<uint8_t>& code) -> void {
+  for (size_t i = 0; i < code.size(); ++i) {
+    poke(static_cast<uint16_t>(address + i), code.at(i));
+  }
+  CpuRegisters* regs = cpu_get_registers();
+  REQUIRE(regs != nullptr);
+  regs->pc = address;
+  regs->is_jammed = 0;
+}
+
+// JMP to itself: the machine stays alive and the screen never moves.
+const std::vector<uint8_t> program_idle = {0x4C, 0x00, 0x03};
+
+// Writes one character to the top-left cell, then idles. One change, then
+// quiet — what a game redrawing a screen and waiting for input looks like.
+const std::vector<uint8_t> program_draw_once = {
+    0xA9, 0xC1,        // LDA #$C1
+    0x8D, 0x00, 0x04,  // STA $0400
+    0x4C, 0x05, 0x03   // JMP $0305
+};
+
+// Copies the keyboard latch to the top-left cell, forever. What the running
+// program can see of an input, as opposed to what the peripheral holds.
+const std::vector<uint8_t> program_watch_keyboard = {
+    0xAD, 0x00, 0xC0,  // LDA $C000
+    0x8D, 0x00, 0x04,  // STA $0400
+    0x4C, 0x00, 0x03   // JMP $0300
+};
+
+// Never stops repainting, which is the case a wait must not sit out forever.
+const std::vector<uint8_t> program_draw_forever = {
+    0xEE, 0x00, 0x04,  // INC $0400
+    0x4C, 0x00, 0x03   // JMP $0300
+};
+
+// The game port keeps no positions a test can ask for, so a test reads a stick
+// the way a program does: the monitor's PREAD loop, copied here so it does not
+// depend on which ROM bank the machine left in, counts how long the paddle's
+// timer stays high. This reads one paddle over and over into the top-left
+// cell, so after a frame the cell holds where the stick was during it.
+auto program_read_paddle(uint8_t paddle) -> std::vector<uint8_t> {
+  return {
+      0xA2, paddle,      // LDX #paddle
+      0xAD, 0x70, 0xC0,  // LDA $C070   trigger the timers
+      0xA0, 0x00,        // LDY #0
+      0xEA, 0xEA,        // NOP NOP
+      0xBD, 0x64, 0xC0,  // LDA $C064,X
+      0x10, 0x04,        // BPL $0312   fallen: Y is the count
+      0xC8,              // INY
+      0xD0, 0xF8,        // BNE $0309
+      0x88,              // DEY         stayed high past 255
+      0x8C, 0x00, 0x04,  // STY $0400
+      0x4C, 0x00, 0x03   // JMP $0300
+  };
+}
+
+// Where the program saw the stick, after `frames` frames of reading it. PREAD
+// counts in steps of about eleven cycles, so a position comes back within a
+// count or two of what was sent.
+auto paddle_read(uint8_t paddle, int frames = 2) -> int {
+  run_program(0x0300, program_read_paddle(paddle));
+  ok_result("run_frames", {{"frames", frames}});
+  const uint8_t* cell = mem_get_main_ptr(0x0400);
+  REQUIRE(cell != nullptr);
+  return *cell;
+}
+
+auto near(int read, int sent) -> bool {
+  return read >= sent - 3 && read <= sent + 3;
+}
+
+// A button is a switch on the game connector's line; true is pressed.
+auto button_down(uint8_t line) -> bool { return switch_inputs_level(line); }
+
+auto wait_params(int64_t max_frames, int64_t chunk) -> Json {
+  Json params;
+  params["max_frames"] = max_frames;
+  params["chunk"] = chunk;
+  params["stable"] = 2;
+  // Full duty: the rest between chunks exists to keep a long wait from cooking
+  // a core, and a test has no reason to pay for it.
+  params["duty"] = 100;
+  return params;
+}
+
+// --- socket helpers --------------------------------------------------------
+
+struct AgentSocketFixture_t {
+  std::string directory;
+  std::string path;
+  int fd = -1;
+
+  AgentSocketFixture_t() {
+    std::vector<char> pattern(64);
+    const char* tmpdir = getenv("TMPDIR");
+    const std::string base =
+        (tmpdir != nullptr && tmpdir[0] != '\0') ? tmpdir : "/tmp";
+    const std::string tpl = base + "/linapple-agent-XXXXXX";
+    pattern.assign(tpl.begin(), tpl.end());
+    pattern.push_back('\0');
+    REQUIRE(mkdtemp(pattern.data()) != nullptr);
+    directory = pattern.data();
+    path = directory + "/agent.sock";
+  }
+
+  ~AgentSocketFixture_t() {
+    disconnect();
+    agent_server_stop();
+    unlink(path.c_str());
+    rmdir(directory.c_str());
+  }
+
+  AgentSocketFixture_t(const AgentSocketFixture_t&) = delete;
+  auto operator=(const AgentSocketFixture_t&) -> AgentSocketFixture_t& = delete;
+  AgentSocketFixture_t(AgentSocketFixture_t&&) = delete;
+  auto operator=(AgentSocketFixture_t&&) -> AgentSocketFixture_t& = delete;
+
+  auto start() -> void {
+    REQUIRE(agent_server_start(path.c_str()) == 0);
+    REQUIRE(agent_server_is_active());
+  }
+
+  auto connect_client() -> void {
+    fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    REQUIRE(fd >= 0);
+    sockaddr_un addr = {};
+    addr.sun_family = AF_UNIX;
+    std::memcpy(static_cast<void*>(addr.sun_path), path.c_str(),
+                path.size() + 1);
+    REQUIRE(connect(fd, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) == 0);
+    // Non-blocking on this side too: the server drains only when the test
+    // pumps it, so a blocking write of a large request would deadlock against
+    // a test that is waiting to make that very call.
+    const int flags = fcntl(fd, F_GETFL, 0);
+    REQUIRE(fcntl(fd, F_SETFL, flags | O_NONBLOCK) == 0);
+    agent_server_poll(0);
+    REQUIRE(agent_server_client_count() == 1);
+  }
+
+  auto disconnect() -> void {
+    if (fd >= 0) {
+      close(fd);
+      fd = -1;
+    }
+  }
+
+  auto send_raw(const std::string& payload) -> void {
+    size_t sent = 0;
+    while (sent < payload.size()) {
+      const ssize_t written =
+          send(fd, payload.data() + sent, payload.size() - sent, MSG_NOSIGNAL);
+      if (written > 0) {
+        sent += static_cast<size_t>(written);
+        continue;
+      }
+      if (written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+        agent_server_poll(0);
+        continue;
+      }
+      FAIL("send to agent socket failed");
+      return;
+    }
+  }
+
+  // Pumps both sides until the requested number of newline-terminated replies
+  // has arrived, or the budget runs out. A bounded loop rather than a blocking
+  // read keeps a regression from turning into a hung test run.
+  auto collect_replies(size_t count) -> std::vector<std::string> {
+    std::string inbox;
+    std::vector<std::string> lines;
+    for (int attempt = 0; attempt < 200 && lines.size() < count; ++attempt) {
+      agent_server_poll(1);
+      std::vector<char> chunk(4096);
+      const ssize_t got = recv(fd, chunk.data(), chunk.size(), 0);
+      if (got > 0) {
+        inbox.append(chunk.data(), static_cast<size_t>(got));
+      }
+      size_t start = 0;
+      lines.clear();
+      while (true) {
+        const size_t newline = inbox.find('\n', start);
+        if (newline == std::string::npos) {
+          break;
+        }
+        lines.push_back(inbox.substr(start, newline - start));
+        start = newline + 1;
+      }
+    }
+    return lines;
+  }
+};
+
+}  // namespace
