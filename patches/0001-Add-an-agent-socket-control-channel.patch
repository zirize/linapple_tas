+TEST_CASE("Agent: only keys a client could send back are logged") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  ok_result("input_capture", {{"on", true}});
+
+  // The arrows arrive as LinAppleKey values a client cannot send, so they are
+  // folded onto the control codes the protocol documents for them.
+  record_key(0x100, true);  // up
+  record_key(0x101, true);  // down
+  record_key(0x102, true);  // left
+  record_key(0x103, true);  // right
+  // Function keys and modifiers never reach the Apple II as keystrokes.
+  record_key(0x200, true);  // F1
+  record_key(0x400, true);  // left shift
+  record_key(0, true);
+
+  const Json events = ok_result("input_poll").at("events");
+  REQUIRE(events.size() == 4);
+  CHECK(events.at(0).at("code").get<int>() == 0x0B);
+  CHECK(events.at(1).at("code").get<int>() == 0x0A);
+  CHECK(events.at(2).at("code").get<int>() == 0x08);
+  CHECK(events.at(3).at("code").get<int>() == 0x15);
+  agent_input_set_capture(false, 0);
+}
+
+TEST_CASE("Agent: what is logged is the byte the machine will see") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  ok_result("input_capture", {{"on", true}});
+
+  // Shift is not something a client can send. It changes what the key held
+  // with it turns into, so the log has to carry the result, not the key the
+  // frontend named.
+  record_key('p', true, /*shift=*/true);
+  record_key('p', false);  // shift let go first, as a person's hand does
+  record_key('8', true, /*shift=*/true);
+  record_key('[', true, /*shift=*/false, /*ctrl=*/true);
+
+  const Json events = ok_result("input_poll").at("events");
+  REQUIRE(events.size() == 4);
+  CHECK(events.at(0).at("code").get<int>() == 'P');
+  // The release names the byte its press did, or a movie would be holding down
+  // a key it never pressed.
+  CHECK(events.at(1).at("code").get<int>() == 'P');
+  CHECK(events.at(1).at("value").get<int>() == 0);
+  CHECK(events.at(2).at("code").get<int>() == '*');
+  CHECK(events.at(3).at("code").get<int>() == 0x1B);  // ctrl-[ is escape
+  agent_input_set_capture(false, 0);
+}
+
+TEST_CASE("Agent: a full buffer says how much it lost") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+  ok_result("input_capture", {{"on", true}, {"limit", 4}});
+
+  for (int i = 0; i < 10; ++i) {
+    agent_input_record_joy_axis(0, i);
+  }
+
+  const Json result = ok_result("input_poll");
+  const Json& events = result.at("events");
+  REQUIRE(events.size() == 4);
+  // The oldest go first: a recorder still has a use for the newest input.
+  CHECK(events.at(0).at("value").get<int>() == 6);
+  CHECK(events.at(3).at("value").get<int>() == 9);
+  CHECK(result.at("dropped").get<int>() == 6);
+
+  // Re-arming starts a clean count.
+  ok_result("input_capture", {{"on", true}});
+  CHECK(ok_result("input_poll").at("dropped").get<int>() == 0);
+  agent_input_set_capture(false, 0);
+}
