+namespace {
+
+using Json = nlohmann::json;
+
+constexpr int agent_protocol_version = 1;
+constexpr uint32_t apple2_frame_cycles = 17030;
+constexpr uint32_t max_step_frames = 60 * 60 * 10;
+constexpr size_t max_mem_read_len = 0x10000;
+constexpr int64_t max_input_capture_limit = 1 << 20;
+constexpr int text_cols_40 = 40;
+constexpr int text_cols_80 = 80;
+constexpr int text_row_count = 24;
+constexpr uint16_t text_page1_base = 0x0400;
+constexpr uint16_t text_page2_offset = 0x0400;
+constexpr uint16_t hires_page1_base = 0x2000;
+constexpr uint16_t hires_page2_base = 0x4000;
+constexpr size_t hires_page_size = 0x2000;
+
+constexpr const char* base64_alphabet =
+    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+auto base64_encode(const uint8_t* data, size_t size) -> std::string {
+  std::string out;
+  out.reserve(((size + 2) / 3) * 4);
+  size_t i = 0;
+  while (i + 2 < size) {
+    const uint32_t triple = (static_cast<uint32_t>(data[i]) << 16) |
+                            (static_cast<uint32_t>(data[i + 1]) << 8) |
+                            static_cast<uint32_t>(data[i + 2]);
+    out.push_back(base64_alphabet[(triple >> 18) & 0x3F]);
+    out.push_back(base64_alphabet[(triple >> 12) & 0x3F]);
+    out.push_back(base64_alphabet[(triple >> 6) & 0x3F]);
+    out.push_back(base64_alphabet[triple & 0x3F]);
+    i += 3;
+  }
+  if (i < size) {
+    uint32_t triple = static_cast<uint32_t>(data[i]) << 16;
+    const bool has_second = (i + 1) < size;
+    if (has_second) {
+      triple |= static_cast<uint32_t>(data[i + 1]) << 8;
+    }
+    out.push_back(base64_alphabet[(triple >> 18) & 0x3F]);
+    out.push_back(base64_alphabet[(triple >> 12) & 0x3F]);
+    out.push_back(has_second ? base64_alphabet[(triple >> 6) & 0x3F] : '=');
+    out.push_back('=');
+  }
+  return out;
+}
+
+auto base64_decode_char(char c) -> int {
+  if (c >= 'A' && c <= 'Z') return c - 'A';
+  if (c >= 'a' && c <= 'z') return c - 'a' + 26;
+  if (c >= '0' && c <= '9') return c - '0' + 52;
+  if (c == '+') return 62;
+  if (c == '/') return 63;
+  return -1;
+}
+
+auto base64_decode(const std::string& text, std::vector<uint8_t>* out) -> bool {
+  uint32_t accumulator = 0;
+  int bits = 0;
+  for (const char c : text) {
+    if (c == '=' || c == '\n' || c == '\r') {
+      continue;
+    }
+    const int value = base64_decode_char(c);
+    if (value < 0) {
+      return false;
+    }
+    accumulator = (accumulator << 6) | static_cast<uint32_t>(value);
+    bits += 6;
+    if (bits >= 8) {
+      bits -= 8;
+      out->push_back(static_cast<uint8_t>((accumulator >> bits) & 0xFF));
+    }
+  }
+  return true;
+}
+
+auto make_ok(const Json& request, Json result) -> std::string {
+  Json response;
+  response["id"] = request.contains("id") ? request.at("id") : Json(nullptr);
+  response["ok"] = true;
+  response["result"] = std::move(result);
+  return response.dump();
+}
+
+auto make_error(const Json& request, const std::string& message)
+    -> std::string {
+  Json response;
+  response["id"] = request.contains("id") ? request.at("id") : Json(nullptr);
+  response["ok"] = false;
+  response["error"] = message;
+  return response.dump();
+}
+
+auto param_int(const Json& params, const char* key, int64_t fallback)
+    -> int64_t {
+  if (!params.contains(key) || !params.at(key).is_number()) {
+    return fallback;
+  }
+  return params.at(key).get<int64_t>();
+}
+
+auto param_bool(const Json& params, const char* key, bool fallback) -> bool {
+  if (!params.contains(key) || !params.at(key).is_boolean()) {
+    return fallback;
+  }
+  return params.at(key).get<bool>();
+}
+
+auto param_string(const Json& params, const char* key) -> std::string {
+  if (!params.contains(key) || !params.at(key).is_string()) {
+    return {};
+  }
+  return params.at(key).get<std::string>();
+}
+
+// --- run control -----------------------------------------------------------
+
+// Runs exactly `frames` emulated frames and parks the machine again. Turbo and
+// the disk-driven full-speed path both multiply the cycles a single
+// linapple_run_frame() call consumes, so deterministic stepping disables them
+// for the duration and restores the caller's settings afterwards.
+auto step_frames(uint32_t frames, bool deterministic) -> uint64_t {
+  const AppMode saved_mode = system_state.mode;
+  const bool saved_turbo = linapple_get_turbo();
+  bool saved_disk_turbo = false;
+
+  if (deterministic) {
+    linapple_set_turbo(false);
+    saved_disk_turbo = linapple_set_disk_turbo(false);
+  }
+  system_state.mode = app_mode_running;
+
+  uint64_t executed = 0;
+  for (uint32_t i = 0; i < frames; ++i) {
+    executed += linapple_run_frame(apple2_frame_cycles);
+  }
+
+  system_state.mode = (saved_mode == app_mode_exit) ? app_mode_exit : app_mode_paused;
+  if (deterministic) {
+    linapple_set_turbo(saved_turbo);
+    linapple_set_disk_turbo(saved_disk_turbo);
+  }
+  return executed;
+}
+
+auto mode_name(AppMode mode) -> const char* {
+  switch (mode) {
+    case app_mode_logo:
+      return "logo";
+    case app_mode_paused:
+      return "paused";
+    case app_mode_running:
+      return "running";
+    case app_mode_debug:
+      return "debug";
+    case app_mode_stepping:
+      return "stepping";
+    case app_mode_disk_choose:
+      return "disk_choose";
+    case app_mode_exit:
+      return "exit";
+  }
+  return "unknown";
+}
+
+// --- screen ----------------------------------------------------------------
+
+auto text_row_offset(int row) -> uint16_t {
+  static constexpr std::array<uint16_t, text_row_count> offsets = {
+      0x000, 0x080, 0x100, 0x180, 0x200, 0x280, 0x300, 0x380,
+      0x028, 0x0A8, 0x128, 0x1A8, 0x228, 0x2A8, 0x328, 0x3A8,
+      0x050, 0x0D0, 0x150, 0x1D0, 0x250, 0x2D0, 0x350, 0x3D0};
+  return offsets.at(static_cast<size_t>(row));
+}
+
+// Maps a screen-code byte to printable ASCII. Inverse and flashing cells differ
+// only in their high bits, which carry no textual meaning for a reader.
+auto screen_code_to_ascii(uint8_t code, bool alt_charset) -> char {
+  uint8_t ascii = 0;
+  if (code >= 0x80) {
+    ascii = code & 0x7F;
+  } else if (code >= 0x40) {
+    ascii = alt_charset ? code : static_cast<uint8_t>(code - 0x40);
+  } else {
+    ascii = code;
+  }
+  if (ascii < 0x20) {
+    ascii = static_cast<uint8_t>(ascii + 0x40);
+  }
+  if (ascii == 0x7F) {
+    ascii = ' ';
+  }
+  return static_cast<char>(ascii);
+}
+
+auto read_text_screen() -> Json {
+  const bool is_80col = video_get_sw_80col();
+  const bool alt_charset = video_get_sw_alt_charset();
+  const uint16_t page_offset = video_get_sw_page2() ? text_page2_offset : 0;
+  const int columns = is_80col ? text_cols_80 : text_cols_40;
+
+  Json lines = Json::array();
+  for (int row = 0; row < text_row_count; ++row) {
+    std::string line;
+    line.reserve(static_cast<size_t>(columns));
+    for (int col = 0; col < columns; ++col) {
+      const uint16_t addr = static_cast<uint16_t>(
+          text_page1_base + page_offset + text_row_offset(row) +
+          (is_80col ? (col / 2) : col));
+      const uint8_t* cell = (is_80col && (col % 2) == 0)
+                                ? mem_get_aux_ptr(addr)
+                                : mem_get_main_ptr(addr);
+      line.push_back(cell != nullptr ? screen_code_to_ascii(*cell, alt_charset)
+                                     : ' ');
+    }
+    lines.push_back(line);
+  }
+
+  Json result;
+  result["columns"] = columns;
+  result["rows"] = text_row_count;
+  result["lines"] = std::move(lines);
+  result["text_mode"] = video_get_sw_text();
+  result["mixed"] = video_get_sw_mixed();
+  return result;
+}
+
+auto capture_screen() -> Json {
+  const uint32_t* pixels = video_get_output_buffer();
+  Json result;
+  result["width"] = video_width;
+  result["height"] = video_height;
+  result["format"] = "bgra8888";
+  if (pixels == nullptr) {
+    result["data"] = "";
+    return result;
+  }
+  const size_t byte_count =
+      static_cast<size_t>(video_width) * video_height * sizeof(uint32_t);
+  result["data"] =
+      base64_encode(reinterpret_cast<const uint8_t*>(pixels), byte_count);
+  return result;
+}
+
+constexpr uint64_t fnv_offset = 1469598103934665603ULL;
+constexpr uint64_t fnv_prime = 1099511628211ULL;
+
+// FNV-1a over the active hi-res page. A client watching for the screen to
+// change needs only to know whether it did, and shipping 8 KB per check turns
+// a wait into a storm of round trips.
+auto hires_page_hash(bool page2) -> uint64_t {
+  // Every byte, not a sample of them. Hashing 8 KB costs microseconds against
+  // the ten million cycles a wait emulates between checks, and sampling would
+  // miss a single changed character — which a caller reading the screen as
+  // text very much cares about, and which lets a cached decode go stale.
+  const uint16_t base = page2 ? hires_page2_base : hires_page1_base;
+  const uint8_t* page = mem_get_main_ptr(base);
+  if (page == nullptr) {
+    return 0;
+  }
+  uint64_t hash = fnv_offset;
+  for (size_t i = 0; i < hires_page_size; ++i) {
+    hash ^= static_cast<uint64_t>(page[i]);
+    hash *= fnv_prime;
+  }
+  return hash;
+}
+
+// The same idea over the visible text cells. Only the cells are hashed, using
+// the same addressing as read_text_screen: the 64 bytes of screen holes the
+// rows skip belong to peripherals as scratch, and their churn would keep a
+// wait from ever settling.
+auto text_page_hash(bool page2) -> uint64_t {
+  const bool is_80col = video_get_sw_80col();
+  const uint16_t page_offset = page2 ? text_page2_offset : 0;
+  const int columns = is_80col ? text_cols_80 : text_cols_40;
+
+  uint64_t hash = fnv_offset;
+  for (int row = 0; row < text_row_count; ++row) {
+    for (int col = 0; col < columns; ++col) {
+      const uint16_t addr = static_cast<uint16_t>(
+          text_page1_base + page_offset + text_row_offset(row) +
+          (is_80col ? (col / 2) : col));
+      const uint8_t* cell = (is_80col && (col % 2) == 0)
+                                ? mem_get_aux_ptr(addr)
+                                : mem_get_main_ptr(addr);
+      hash ^= static_cast<uint64_t>(cell != nullptr ? *cell : 0);
+      hash *= fnv_prime;
+    }
+  }
+  return hash;
+}
+
+// Which page a caller means by "the screen" depends on what the machine is
+// displaying. A game drawing its own font into hi-res leaves the text page
+// untouched, and a game using the hardware text page never touches hi-res —
+// watching the wrong one reports "nothing changed" until the frame budget runs
+// out. Mixed mode stays on hi-res deliberately: hi-res games treat the text
+// page as scratch RAM, so folding it in would mean a screen that never settles.
+auto screen_page_hash() -> uint64_t {
+  const bool page2 = video_get_sw_page2();
+  return video_get_sw_text() ? text_page_hash(page2) : hires_page_hash(page2);
+}
+
+// --- disk ------------------------------------------------------------------
+
+auto query_disk_status(DiskStatus* status) -> bool {
+  size_t size = sizeof(DiskStatus);
+  return peripheral_query(disk_default_slot, disk_query_status, status,
+                          &size) == peripheral_ok;
+}
+
+auto disk_status_json() -> Json {
+  DiskStatus status = {};
+  Json result;
+  if (!query_disk_status(&status)) {
+    result["drives"] = Json::array();
+    return result;
+  }
+  Json drives = Json::array();
+  Json drive0;
+  drive0["drive"] = 0;
+  drive0["loaded"] = status.drive0_loaded != 0;
+  drive0["spinning"] = status.drive0_spinning != 0;
+  drive0["writing"] = status.drive0_writing != 0;
+  drive0["write_protected"] = status.drive0_write_protected != 0;
+  drive0["name"] = std::string(status.drive0_name);
+  drive0["path"] = std::string(status.drive0_full_path);
+  drive0["last_error"] = status.drive0_last_error;
+  drives.push_back(std::move(drive0));
+  Json drive1;
+  drive1["drive"] = 1;
+  drive1["loaded"] = status.drive1_loaded != 0;
+  drive1["spinning"] = status.drive1_spinning != 0;
+  drive1["writing"] = status.drive1_writing != 0;
+  drive1["write_protected"] = status.drive1_write_protected != 0;
+  drive1["name"] = std::string(status.drive1_name);
+  drive1["path"] = std::string(status.drive1_full_path);
+  drive1["last_error"] = status.drive1_last_error;
+  drives.push_back(std::move(drive1));
+  result["drives"] = std::move(drives);
+  return result;
+}
+
+// --- command table ---------------------------------------------------------
+
+const std::array<const char*, 24> command_names = {
+    "ping",     "version",     "commands",   "status",     "key_press",
+    "key_type", "key_state",   "joy_axis",   "joy_button", "run_frames",
+    "pause",    "resume",      "reset",      "speed_set",  "turbo_set",
+    "quit",     "disk_insert", "disk_eject", "disk_swap",  "disk_status",
+    "mem_read", "mem_write",   "cpu_regs",   "screen_text"};
+
+auto dispatch(const std::string& cmd, const Json& params, const Json& request)
+    -> std::string {
+  if (cmd == "ping") {
+    return make_ok(request, Json::object());
+  }
+
+  if (cmd == "version") {
+    Json result;
+    result["protocol"] = agent_protocol_version;
+    result["emulator"] = "linapple";
+#ifdef LINAPPLE_FRONTEND_NAME
+    result["frontend"] = LINAPPLE_FRONTEND_NAME;
+#endif
+    return make_ok(request, result);
+  }
+
+  if (cmd == "commands") {
+    Json names = Json::array();
+    for (const char* name : command_names) {
+      names.push_back(name);
+    }
+    names.push_back("screen_hires");
+    names.push_back("screen_hash");
+    names.push_back("run_until_change");
+    names.push_back("screen_capture");
+    names.push_back("state_save");
+    names.push_back("state_load");
+    names.push_back("input_capture");
+    names.push_back("input_poll");
+    names.push_back("audio_dump");
+    Json result;
+    result["commands"] = std::move(names);
+    return make_ok(request, result);
+  }
+
+  if (cmd == "status") {
+    Json result;
+    result["mode"] = mode_name(system_state.mode);
+    result["speed"] = linapple_get_speed();
+    result["turbo"] = linapple_get_turbo();
+    result["cycles"] = cpu_get_cumulative_cycles();
+    result["text_mode"] = video_get_sw_text();
+    result["hires"] = video_get_sw_hires();
+    result["col80"] = video_get_sw_80col();
+    result["mixed"] = video_get_sw_mixed();
+    result["page2"] = video_get_sw_page2();
+    result["alt_charset"] = video_get_sw_alt_charset();
+    return make_ok(request, result);
+  }
+
+  if (cmd == "key_press") {
+    const int64_t key = param_int(params, "key", -1);
+    if (key < 0 || key > 0xFF) {
+      return make_error(request, "key must be an Apple II code in 0..255");
+    }
+    const auto code = static_cast<uint8_t>(key);
+    linapple_set_key_state(code, true);
+    linapple_set_key_state(code, false);
+    return make_ok(request, Json::object());
+  }
+
+  if (cmd == "key_state") {
+    const int64_t key = param_int(params, "key", -1);
+    if (key < 0 || key > 0xFF) {
+      return make_error(request, "key must be an Apple II code in 0..255");
+    }
+    linapple_set_key_state(static_cast<uint8_t>(key),
+                           param_bool(params, "down", true));
+    return make_ok(request, Json::object());
+  }
+
+  if (cmd == "key_type") {
+    const std::string text = param_string(params, "text");
+    if (text.empty()) {
+      return make_error(request, "text is required");
+    }
+    // The Apple II keyboard is a single-byte latch: a character pushed before
+    // the running program has read the previous one is simply lost. Running
+    // the gap *before* each key, rather than after, also covers the first
+    // character, which would otherwise land on whatever the machine was still
+    // holding when the command arrived.
+    const int64_t frames_between = param_int(params, "frames_between", 3);
+    for (const char c : text) {
+      if (frames_between > 0) {
+        step_frames(static_cast<uint32_t>(frames_between), false);
+      }
+      const auto code = static_cast<uint8_t>(c);
+      linapple_set_key_state(code, true);
+      linapple_set_key_state(code, false);
+    }
+    if (frames_between > 0) {
+      step_frames(static_cast<uint32_t>(frames_between), false);
+    }
+    Json result;
+    result["typed"] = text.size();
+    return make_ok(request, result);
+  }
+
+  if (cmd == "joy_axis") {
+    const int64_t axis = param_int(params, "axis", -1);
+    if (axis < 0 || axis > 3) {
+      return make_error(request, "axis must be in 0..3");
+    }
+    // An absolute paddle position, not a nudge: 0 and 255 are the ends of
+    // travel and 127 is the stick at rest. Silently centring an absent value
+    // would look like a stick that moved on its own.
+    const int64_t value = param_int(params, "value", -1);
+    if (value < 0 || value > 0xFF) {
+      return make_error(request, "value must be a paddle position in 0..255");
+    }
+    linapple_set_joystick_axis(static_cast<int>(axis), static_cast<int>(value));
+    return make_ok(request, Json::object());
+  }
+
+  if (cmd == "joy_button") {
+    // Three pushbuttons, at $C061 through $C063. A fourth was accepted here
+    // and then dropped by the peripheral, which answered ok for a press that
+    // never happened.
+    const int64_t button = param_int(params, "button", -1);
+    if (button < 0 || button > 2) {
+      return make_error(request, "button must be in 0..2");
+    }
+    // A button is a switch on the game connector's line, the same one a
+    // frontend's controller closes.
+    linapple_set_game_switch(static_cast<uint8_t>(button),
+                             param_bool(params, "down", false));
+    return make_ok(request, Json::object());
+  }
+
+  if (cmd == "run_frames") {
+    const int64_t frames = param_int(params, "frames", 1);
+    if (frames < 0 || static_cast<uint64_t>(frames) > max_step_frames) {
+      return make_error(request, "frames out of range");
+    }
+    const uint64_t executed =
+        step_frames(static_cast<uint32_t>(frames),
+                    param_bool(params, "deterministic", true));
+    Json result;
+    result["frames"] = frames;
+    result["cycles"] = executed;
+    result["mode"] = mode_name(system_state.mode);
+    return make_ok(request, result);
+  }
+
+  if (cmd == "pause") {
+    system_state.mode = app_mode_paused;
+    return make_ok(request, Json::object());
+  }
+
+  if (cmd == "resume") {
+    system_state.mode = app_mode_running;
+    return make_ok(request, Json::object());
+  }
+
+  if (cmd == "reset") {
+    if (param_bool(params, "full", false)) {
+      linapple_reset_hard();
+    } else {
+      linapple_reset_soft();
+    }
+    return make_ok(request, Json::object());
+  }
+
+  if (cmd == "speed_set") {
+    const int64_t speed = param_int(params, "speed", emulation_speed_normal);
+    if (speed < emulation_speed_min || speed > emulation_speed_max) {
+      return make_error(request, "speed out of range");
+    }
+    linapple_set_speed(static_cast<uint32_t>(speed));
+    Json result;
+    result["speed"] = linapple_get_speed();
+    return make_ok(request, result);
+  }
+
+  if (cmd == "turbo_set") {
+    linapple_set_turbo(param_bool(params, "turbo", false));
+    Json result;
+    result["turbo"] = linapple_get_turbo();
+    return make_ok(request, result);
+  }
+
+  if (cmd == "quit") {
+    system_state.mode = app_mode_exit;
+    return make_ok(request, Json::object());
+  }
+
+  if (cmd == "disk_insert") {
+    const std::string path = param_string(params, "path");
+    const int64_t drive = param_int(params, "drive", -1);
+    if (path.empty()) {
+      return make_error(request, "path is required");
+    }
+    if (drive != 0 && drive != 1) {
+      return make_error(request, "drive must be 0 or 1");
+    }
+    if (path.size() >= disk_insert_path_max) {
+      return make_error(request, "path too long");
+    }
+    DiskInsertCmd insert = {};
+    std::memcpy(static_cast<void*>(insert.path), path.c_str(), path.size() + 1);
+    insert.drive = static_cast<uint8_t>(drive);
+    insert.write_protected =
+        param_bool(params, "write_protected", false) ? 1 : 0;
+    const PeripheralStatus status = peripheral_command(
+        disk_default_slot, disk_cmd_insert, &insert, sizeof(insert));
+    if (status != peripheral_ok) {
+      return make_error(request, "disk_insert failed");
+    }
+    return make_ok(request, disk_status_json());
+  }
+
+  if (cmd == "disk_eject") {
+    const int64_t drive = param_int(params, "drive", -1);
+    if (drive != 0 && drive != 1) {
+      return make_error(request, "drive must be 0 or 1");
+    }
+    DiskEjectCmd eject = {};
+    eject.drive = static_cast<uint8_t>(drive);
+    if (peripheral_command(disk_default_slot, disk_cmd_eject, &eject,
+                           sizeof(eject)) != peripheral_ok) {
+      return make_error(request, "disk_eject failed");
+    }
+    return make_ok(request, disk_status_json());
+  }
+
+  if (cmd == "disk_swap") {
+    if (peripheral_command(disk_default_slot, disk_cmd_swap_drives, nullptr,
+                           0) != peripheral_ok) {
+      return make_error(request, "disk_swap failed");
+    }
+    return make_ok(request, disk_status_json());
+  }
+
+  if (cmd == "disk_status") {
+    return make_ok(request, disk_status_json());
+  }
+
+  if (cmd == "mem_read") {
+    const int64_t addr = param_int(params, "addr", -1);
+    const int64_t len = param_int(params, "len", 1);
+    if (addr < 0 || addr > 0xFFFF) {
+      return make_error(request, "addr must be in 0..65535");
+    }
+    if (len <= 0 || static_cast<size_t>(len) > max_mem_read_len ||
+        (addr + len) > 0x10000) {
+      return make_error(request, "len out of range");
+    }
+    const bool aux = param_bool(params, "aux", false);
+    std::vector<uint8_t> buffer;
+    buffer.reserve(static_cast<size_t>(len));
+    for (int64_t i = 0; i < len; ++i) {
+      const auto address = static_cast<uint16_t>(addr + i);
+      const uint8_t* byte =
+          aux ? mem_get_aux_ptr(address) : mem_get_main_ptr(address);
+      buffer.push_back(byte != nullptr ? *byte : 0);
+    }
+    Json result;
+    result["addr"] = addr;
+    result["len"] = len;
+    result["data"] = base64_encode(buffer.data(), buffer.size());
+    return make_ok(request, result);
+  }
+
+  if (cmd == "mem_write") {
+    const int64_t addr = param_int(params, "addr", -1);
+    if (addr < 0 || addr > 0xFFFF) {
+      return make_error(request, "addr must be in 0..65535");
+    }
+    std::vector<uint8_t> bytes;
+    if (params.contains("data") && params.at("data").is_string()) {
+      if (!base64_decode(params.at("data").get<std::string>(), &bytes)) {
+        return make_error(request, "data is not valid base64");
+      }
+    } else if (params.contains("bytes") && params.at("bytes").is_array()) {
+      for (const Json& entry : params.at("bytes")) {
+        if (!entry.is_number()) {
+          return make_error(request, "bytes must contain numbers only");
+        }
+        bytes.push_back(static_cast<uint8_t>(entry.get<int64_t>() & 0xFF));
+      }
+    } else {
+      return make_error(request, "data or bytes is required");
+    }
+    if (bytes.empty() ||
+        (addr + static_cast<int64_t>(bytes.size())) > 0x10000) {
+      return make_error(request, "write range out of bounds");
+    }
+    const bool aux = param_bool(params, "aux", false);
+    for (size_t i = 0; i < bytes.size(); ++i) {
+      const auto address =
+          static_cast<uint16_t>(addr + static_cast<int64_t>(i));
+      uint8_t* target =
+          aux ? mem_get_aux_ptr(address) : mem_get_main_ptr(address);
+      if (target != nullptr) {
+        *target = bytes.at(i);
+      }
+    }
+    Json result;
+    result["written"] = bytes.size();
+    return make_ok(request, result);
+  }
+
+  if (cmd == "cpu_regs") {
+    const CpuRegisters* regs = cpu_get_registers();
+    if (regs == nullptr) {
+      return make_error(request, "cpu registers unavailable");
+    }
+    Json result;
+    result["a"] = regs->a;
+    result["x"] = regs->x;
+    result["y"] = regs->y;
+    result["pc"] = regs->pc;
+    result["sp"] = regs->sp;
+    result["ps"] = regs->ps;
+    result["cycles"] = cpu_get_cumulative_cycles();
+    return make_ok(request, result);
+  }
+
+  if (cmd == "screen_text") {
+    return make_ok(request, read_text_screen());
+  }
+
+  if (cmd == "screen_hash") {
+    Json result;
+    result["page"] = video_get_sw_page2() ? 2 : 1;
+    result["source"] = video_get_sw_text() ? "text" : "hires";
+    result["hash"] = screen_page_hash();
+    return make_ok(request, result);
+  }
+
+  if (cmd == "run_until_change") {
+    // Waiting for a game to redraw is a polling loop, and running it over the
+    // socket costs a round trip per sample — hundreds of wakeups for a single
+    // keypress, which shows up as a CPU held at its top clock while usage
+    // looks near idle. Running the loop here makes it one round trip.
+    const int64_t max_frames = param_int(params, "max_frames", 600);
+    const int64_t chunk = param_int(params, "chunk", 48);
+    const int64_t stable_target = param_int(params, "stable", 2);
+    if (max_frames < 0 || static_cast<uint64_t>(max_frames) > max_step_frames ||
+        chunk <= 0) {
+      return make_error(request, "max_frames or chunk out of range");
+    }
+
+    const uint64_t started_as = screen_page_hash();
+    uint64_t previous = started_as;
+    uint64_t executed = 0;
+    int64_t spent = 0;
+    int64_t stable = 0;
+    bool changed = false;
+
+    // Emulating flat out pins a core at its top clock. Resting in proportion
+    // to the work keeps a long wait from turning into a heat problem, and the
+    // pause is short enough that responsiveness is unaffected.
+    const int64_t duty_percent = std::min<int64_t>(
+        std::max<int64_t>(param_int(params, "duty", 60), 5), 100);
+
+    // A sub-millisecond sleep costs a wakeup and saves nothing — the core never
+    // reaches a deep idle state at that granularity, which is the pattern that
+    // shows up as a high clock under near-idle usage. Owe the rest instead and
+    // pay it once it is worth taking.
+    constexpr auto min_rest = std::chrono::milliseconds(1);
+    auto owed = std::chrono::nanoseconds::zero();
+
+    while (spent < max_frames) {
+      const auto chunk_started = std::chrono::steady_clock::now();
+      executed += step_frames(static_cast<uint32_t>(chunk), false);
+      spent += chunk;
+      if (duty_percent < 100) {
+        const auto worked = std::chrono::steady_clock::now() - chunk_started;
+        owed += std::chrono::duration_cast<std::chrono::nanoseconds>(
+            worked * (100 - duty_percent) / duty_percent);
+        if (owed >= min_rest) {
+          std::this_thread::sleep_for(owed);
+          owed = std::chrono::nanoseconds::zero();
+        }
+      }
+      const uint64_t current = screen_page_hash();
+      if (current != previous) {
+        changed = true;
+        stable = 0;
+        previous = current;
+        continue;
+      }
+      if (changed) {
+        ++stable;
+        if (stable >= stable_target) {
+          break;
+        }
+      }
+    }
+
+    Json result;
+    result["frames"] = spent;
+    result["cycles"] = executed;
+    result["changed"] = changed;
+    result["hash"] = previous;
+    result["mode"] = mode_name(system_state.mode);
+    return make_ok(request, result);
+  }
+
+  if (cmd == "screen_hires") {
+    // Games that draw their own text do it straight into the hi-res page, so
+    // handing back those 8 KB lets a client decode the screen itself without
+    // the cost of a full framebuffer capture.
+    const bool page2 = params.contains("page")
+                           ? param_int(params, "page", 1) == 2
+                           : video_get_sw_page2();
+    const uint16_t base = page2 ? hires_page2_base : hires_page1_base;
+    std::vector<uint8_t> buffer;
+    buffer.reserve(hires_page_size);
+    for (size_t i = 0; i < hires_page_size; ++i) {
+      const uint8_t* byte =
+          param_bool(params, "aux", false)
+              ? mem_get_aux_ptr(static_cast<uint16_t>(base + i))
+              : mem_get_main_ptr(static_cast<uint16_t>(base + i));
+      buffer.push_back(byte != nullptr ? *byte : 0);
+    }
+    Json result;
+    result["page"] = page2 ? 2 : 1;
+    result["addr"] = base;
+    result["len"] = hires_page_size;
+    result["hires"] = video_get_sw_hires();
+    result["mixed"] = video_get_sw_mixed();
+    result["data"] = base64_encode(buffer.data(), buffer.size());
+    return make_ok(request, result);
+  }
+
+  if (cmd == "screen_capture") {
+    return make_ok(request, capture_screen());
+  }
+
+  if (cmd == "input_capture") {
+    // A person playing at the window talks to the frontend, not to this
+    // socket, so their input would otherwise be invisible here. Capture is off
+    // until asked for: a session nobody is recording should not be keeping a
+    // buffer of keystrokes.
+    const bool on = param_bool(params, "on", true);
+    const int64_t limit = param_int(params, "limit", 0);
+    if (limit < 0 || limit > max_input_capture_limit) {
+      return make_error(request, "limit out of range");
+    }
+    agent_input_set_capture(on, static_cast<size_t>(limit));
+    Json result;
+    result["capturing"] = agent_input_capturing();
+    result["pending"] = agent_input_pending();
+    return make_ok(request, result);
+  }
+
+  if (cmd == "input_poll") {
+    const int64_t max_events = param_int(params, "max", 256);
+    if (max_events <= 0 || max_events > max_input_capture_limit) {
+      return make_error(request, "max out of range");
+    }
+    std::vector<AgentInputEvent_t> taken(static_cast<size_t>(max_events));
+    const size_t count =
+        agent_input_take(static_cast<size_t>(max_events), taken.data());
+    Json events = Json::array();
+    for (size_t i = 0; i < count; ++i) {
+      Json entry;
+      entry["cycles"] = taken.at(i).cycles;
+      entry["kind"] = taken.at(i).kind;
+      entry["code"] = taken.at(i).code;
+      entry["value"] = taken.at(i).value;
+      events.push_back(std::move(entry));
+    }
+    Json result;
+    result["events"] = std::move(events);
+    result["capturing"] = agent_input_capturing();
+    result["pending"] = agent_input_pending();
+    // Input the buffer had to throw away, so a recorder can say its movie is
+    // incomplete rather than quietly producing a shorter one.
+    result["dropped"] = agent_input_dropped();
+    result["cycles"] = cpu_get_cumulative_cycles();
+    return make_ok(request, result);
+  }
+
+  if (cmd == "audio_dump") {
+    // Recording the sound the machine makes, started and stopped on the wire
+    // so that it can be lined up with a replay rather than with the process.
+    // The headless frontend writes what the speaker produced, on emulated
+    // time - a movie replayed at ten times speed still comes out at the right
+    // pitch. The SDL frontends write the mixer's output instead.
+    const bool on = param_bool(params, "on", true);
+    const std::string path = param_string(params, "path");
+    if (on) {
+      if (path.empty()) {
+        return make_error(request, "path is required");
+      }
+      if (!frontend_audio_dump_start(path.c_str())) {
+        return make_error(request,
+                          "this frontend cannot record audio, or the file "
+                          "could not be opened");
+      }
+    } else {
+      frontend_audio_dump_stop();
+    }
+    Json result;
+    const std::string active = frontend_audio_dump_path();
+    result["dumping"] = !active.empty();
+    result["path"] = active;
+    return make_ok(request, result);
+  }
+
+  if (cmd == "state_save") {
+    const std::string path = param_string(params, "path");
+    if (!path.empty()) {
+      save_state_set_filename(path.c_str());
+    }
+    save_state_save();
+    Json result;
+    result["path"] = std::string(save_state_get_filename());
+    return make_ok(request, result);
+  }
+
+  if (cmd == "state_load") {
+    const std::string path = param_string(params, "path");
+    if (!path.empty()) {
+      save_state_set_filename(path.c_str());
+    }
+    save_state_load();
+    Json result;
+    result["path"] = std::string(save_state_get_filename());
+    return make_ok(request, result);
+  }
+
+  return make_error(request, "unknown command: " + cmd);
+}
+
+}  // namespace
+
+auto agent_command_dispatch(const std::string& request_line) -> std::string {
+  Json request = Json::object();
+  Json parsed = Json::parse(request_line, nullptr, false);
+  if (parsed.is_discarded() || !parsed.is_object()) {
+    return make_error(request, "malformed JSON request");
+  }
+  request = std::move(parsed);
+
+  if (!request.contains("cmd") || !request.at("cmd").is_string()) {
+    return make_error(request, "cmd is required");
+  }
+  const auto cmd = request.at("cmd").get<std::string>();
+
+  Json params = Json::object();
+  if (request.contains("params") && request.at("params").is_object()) {
+    params = request.at("params");
+  }
+
+  return dispatch(cmd, params, request);
+}
