+// SPDX-License-Identifier: GPL-2.0-only
+#pragma once
+
+// Unix domain socket control channel for external tool-assistants.
+//
+// Host I/O belongs to the frontend tier, so the socket is owned here while
+// every command handler reaches the machine exclusively through the core bridge
+// in LinAppleCore.h. Each frontend calls agent_server_poll() once per iteration
+// of its own message loop, which keeps emulator state access on the main thread
+// and removes any need for locking.
+
+auto agent_server_start(const char* socket_path) -> int;
+
+// `timeout_ms` is handed straight to poll(): 0 returns at once, which is what a
+// frontend driving its own frame loop wants, while a positive value blocks in
+// the kernel until a command arrives. An idle session should block. Polling
+// with no timeout and sleeping instead wakes the CPU hundreds of times a second
+// for no work, which keeps it out of its deep idle states and drives the clock
+// — and the heat — up even though usage looks near zero.
+auto agent_server_poll(int timeout_ms = 0) -> void;
+auto agent_server_stop() -> void;
+auto agent_server_is_active() -> bool;
+auto agent_server_client_count() -> int;
