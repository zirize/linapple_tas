+// Both callers mean "the stick is here now", which is JOY_CMD_SET_AXIS. This
+// used to drive JOY_CMD_SET_TRIM instead — the calibration offset a user nudges
+// once and leaves alone. Trim is shared by both sticks and has only an x and a
+// y, so the second joystick's axes folded onto the first one's, and a caller's
+// value landed as an offset from the resting 127 rather than a position.
+//
+// Axes are numbered the way the paddle registers are: 0 and 1 are the first
+// stick's x and y, 2 and 3 the second stick's.
 auto linapple_set_joystick_axis(int axis, int value) -> void {
-  JoystickTrimPayload_t payload = {axis == 0, static_cast<int16_t>(value)};
-  peripheral_command(0, JOY_CMD_SET_TRIM, &payload, sizeof(payload));
+  if (axis < 0 || axis > 3) {
+    return;
+  }
+  const int position = (value < 0) ? 0 : ((value > 255) ? 255 : value);
+  JoystickAxisPayload_t payload = {static_cast<uint8_t>(axis >> 1),
+                                   static_cast<uint8_t>(axis & 1),
+                                   static_cast<uint8_t>(position)};
+  peripheral_command(0, JOY_CMD_SET_AXIS, &payload, sizeof(payload));
 }
 
