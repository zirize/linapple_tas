+TEST_CASE("Agent server: one line in, one line out") {
+  AgentSocketFixture_t socket_fixture;
+  socket_fixture.start();
+  socket_fixture.connect_client();
+
+  // Two requests in a single write: a client is entitled to pipeline, and the
+  // blank line and the \r\n ending must not cost it a reply.
+  socket_fixture.send_raw(
+      "{\"cmd\":\"ping\",\"id\":1}\r\n"
+      "\n"
+      "{\"cmd\":\"nope\",\"id\":2}\n");
+
+  const std::vector<std::string> replies = socket_fixture.collect_replies(2);
+  REQUIRE(replies.size() == 2);
+
+  const Json first = Json::parse(replies.at(0), nullptr, false);
+  REQUIRE_FALSE(first.is_discarded());
+  CHECK(first.at("id").get<int>() == 1);
+  CHECK(first.at("ok").get<bool>() == true);
+
+  const Json second = Json::parse(replies.at(1), nullptr, false);
+  REQUIRE_FALSE(second.is_discarded());
+  CHECK(second.at("id").get<int>() == 2);
+  CHECK(second.at("ok").get<bool>() == false);
+
+  CHECK(agent_server_client_count() == 1);
+}
+
+TEST_CASE("Agent server: garbage on the wire does not cost the connection") {
+  AgentSocketFixture_t socket_fixture;
+  socket_fixture.start();
+  socket_fixture.connect_client();
+
+  socket_fixture.send_raw("this is not json\n{\"cmd\":\"ping\",\"id\":9}\n");
