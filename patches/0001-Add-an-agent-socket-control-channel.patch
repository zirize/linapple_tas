+TEST_CASE("Agent server: stopping releases the socket path") {
+  AgentSocketFixture_t socket_fixture;
+  socket_fixture.start();
+  CHECK(access(socket_fixture.path.c_str(), F_OK) == 0);
+
+  socket_fixture.connect_client();
+  agent_server_stop();
+
+  CHECK_FALSE(agent_server_is_active());
+  CHECK(agent_server_client_count() == 0);
+  // A path left behind would make the next session's bind() fail.
+  CHECK(access(socket_fixture.path.c_str(), F_OK) != 0);
+
+  // Starting again on the same path is the restart case, and it works.
+  socket_fixture.start();
+}
