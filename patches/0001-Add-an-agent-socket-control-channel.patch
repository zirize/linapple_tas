+TEST_CASE("Agent: mem_read refuses addresses outside the address space") {
+  TestConfig test_config(TestConfig::disk_ii_only());
+  HeadlessHarness harness(test_config);
+
+  CHECK(rejects("mem_read", {{"addr", -1}}));
+  CHECK(rejects("mem_read", {{"addr", 0x10000}}));
+  CHECK(rejects("mem_read", Json::object()));  // addr defaults to -1
+  CHECK(
+      rejects("mem_read", {{"addr", "0x300"}}));  // wrong type, same as absent
+  CHECK(rejects("mem_read", {{"addr", 0x300}, {"len", 0}}));
+  CHECK(rejects("mem_read", {{"addr", 0x300}, {"len", -4}}));
+  CHECK(rejects("mem_read", {{"addr", 0x300}, {"len", 0x10001}}));
+  // In range on its own, but the read would run off the end of memory.
+  CHECK(rejects("mem_read", {{"addr", 0xFFFF}, {"len", 2}}));
+
+  // The edges that should be allowed still are.
+  CHECK(ok_result("mem_read", {{"addr", 0xFFFF}, {"len", 1}}).at("len") == 1);
+  CHECK(ok_result("mem_read", {{"addr", 0}, {"len", 0x10000}}).at("len") ==
