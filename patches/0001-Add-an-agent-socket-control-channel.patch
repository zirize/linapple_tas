+TEST_CASE("Agent server: a request line past the cap drops the client") {
+  AgentSocketFixture_t socket_fixture;
+  socket_fixture.start();
+  socket_fixture.connect_client();
+
+  // No newline, so nothing is ever dispatched and the buffer just grows. The
+  // cap is what stops one client from spending the emulator's memory; the
+  // largest legitimate request, a 64 KB mem_write, is nowhere near it.
+  const std::string blob(64 * 1024, 'x');
+  size_t sent_total = 0;
+  constexpr size_t give_up_after = 6 * 1024 * 1024;
+  while (agent_server_client_count() > 0 && sent_total < give_up_after) {
+    const ssize_t written =
+        send(socket_fixture.fd, blob.data(), blob.size(), MSG_NOSIGNAL);
+    if (written > 0) {
+      sent_total += static_cast<size_t>(written);
+    } else if (written < 0 && errno != EAGAIN && errno != EWOULDBLOCK) {
+      break;
+    }
+    agent_server_poll(0);
+  }
+
+  CHECK(sent_total > 4 * 1024 * 1024);
+  CHECK(sent_total < give_up_after);
+  CHECK(agent_server_client_count() == 0);
+}
