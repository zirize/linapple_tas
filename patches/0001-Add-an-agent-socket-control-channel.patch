+// What a key event turns into for the machine, without pressing anything.
+//
+// The command handler below uses this to decide what to latch, and the
+// keyboard_query_translate query hands the same answer to a caller that only
+// wants to know - a recorder logging what a person typed, for instance, which
+// has to write down the byte a replay would send rather than the key the
+// frontend happened to name. False means the key reaches the machine as
+// nothing at all: an Apple key, or one this layout has no byte for.
+auto keyboard_translate_key(KeyboardPeripheral_t* kp, const KeyboardEvent_t* ev,
+                            uint32_t* out) -> bool {
+  namespace kp_const = kb;
+
+  if (kp->logic.has_custom_keys && ev->key >= kp_const::positional_threshold) {
+    const int idx = static_cast<int>(ev->key - kp_const::positional_threshold);
+    if (idx >= 0 && idx < KEYBOARD_MAP_SIZE &&
+        (kp->logic.custom_flags[idx] & 6) != 0) {
+      return false;  // mapped to an Apple key: no character is latched
+    }
+  }
+
+  uint32_t key = ev->key;
+  if (key >= kp_const::positional_threshold) {
+    key = keyboard_map_positional(kp, key, ev->mod_shift != 0U,
+                                  ev->mod_ctrl != 0U);
+  } else if (key >= 0x100) {
+    key = keyboard_map_symbolic(key);
+  } else if (key != 0) {
+    key = keyboard_apply_symbolic_shift(
+        key, ev->mod_shift != 0U, ev->mod_ctrl != 0U, kp->logic.caps_lock);
+  }
+
+  if (key > kp_const::key_code_mask) {
+    return false;
+  }
+  *out = key;
+  return true;
+}
